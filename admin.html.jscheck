


    const SUPABASE_URL='https://zrrabfleykuhxyqldxid.supabase.co';
    const SUPABASE_KEY='sb_publishable_kE2y3Hjee9FjjrpQxJQRVg_nE50COrD';
    const sb=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
    const DEV_CODE='RUEDA2026';
    const ACTIVE_STATUSES=['searching','accepted','arrived','in_progress'];
    const $=s=>document.querySelector(s);
    const $$=s=>[...document.querySelectorAll(s)];

    let rides=[];
    let reports=[];
    let fares=[];
    let profiles=[];
    let rideFilter='all';
    let channel=null;
    let reportsTableAvailable=true;
    let fareTableAvailable=true;
    let profilesTableAvailable=true;
    let refreshTimer=null;
    let liveMap=null;
    let liveMapLayers=null;
    let liveMapFilters={drivers:true,requests:true,trips:true};
    let liveMapHasFitted=false;
    let periodicRefresh=null;
    let lastPeopleUpdate=null;

    function toast(message){const el=$('#toast');el.textContent=message;el.classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>el.classList.remove('show'),2500)}
    function esc(value){return String(value??'—').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]))}
    function money(value){return Number(value||0).toLocaleString('es-US',{maximumFractionDigits:0})+' CUP'}
    function safeDate(value){if(!value)return null;const date=new Date(value);return Number.isNaN(date.getTime())?null:date}
    function dateFmt(value){const date=safeDate(value);return date?date.toLocaleString('es-US',{month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit'}):'—'}
    function localDateKey(value){const date=safeDate(value);if(!date)return'';const y=date.getFullYear(),m=String(date.getMonth()+1).padStart(2,'0'),d=String(date.getDate()).padStart(2,'0');return `${y}-${m}-${d}`}
    function isToday(record){return localDateKey(record.created_at)===localDateKey(new Date())}
    function statusLabel(status){return({searching:'Buscando',accepted:'Aceptado',arrived:'Conductor llegó',in_progress:'En curso',finished:'Terminado',canceled:'Cancelado'})[status]||status||'—'}
    function statusClass(status){return ACTIVE_STATUSES.concat(['finished','canceled']).includes(status)?status:'finished'}
    function stars(rating){const n=Math.round(Math.max(0,Math.min(5,Number(rating||0))));return '★'.repeat(n)+'☆'.repeat(5-n)}
    function ownerIdentity(){return localStorage.getItem('sr_admin_email')||'administración'}
    function todayKey(){return localDateKey(new Date())}
    function profileKey(profile){return String(profile?.device_id||profile?.id||'')}
    function profileFor(id){const key=String(id||'');return profiles.find(profile=>profileKey(profile)===key||String(profile?.id||'')===key)||null}
    function approvalLabel(value){return({approved:'Aprobado',pending:'Pendiente',rejected:'Desaprobado',deleted:'Eliminado',blocked:'Bloqueado'})[value]||'Pendiente'}
    function approvalClass(value){return ['approved','pending','rejected','deleted'].includes(value)?value:'pending'}
    function isProfileOnline(profile){if(!profile||profile.status==='deleted'||profile.approval_status==='rejected')return false;const seen=safeDate(profile.last_seen_at)?.getTime()||0;return Boolean(profile.is_online)&&(Date.now()-seen<90*1000||!seen)}
    function latestRideForDriver(driverId){return rides.filter(ride=>String(ride.driver_id||'')===String(driverId||'')).sort((a,b)=>(safeDate(b.updated_at||b.created_at)?.getTime()||0)-(safeDate(a.updated_at||a.created_at)?.getTime()||0))[0]||null}
    function activeDriverIds(){const ids=new Set();profiles.filter(profile=>profile.role==='driver'&&isProfileOnline(profile)).forEach(profile=>ids.add(profileKey(profile)));rides.filter(ride=>ACTIVE_STATUSES.includes(ride.status)&&ride.driver_id).forEach(ride=>{const profile=profileFor(ride.driver_id);if(profile?.status==='deleted'||profile?.status==='blocked'||profile?.approval_status==='rejected')return;ids.add(String(ride.driver_id))});return ids}
    function closeOpsModal(){if(liveMap){liveMap.remove();liveMap=null;liveMapLayers=null;liveMapHasFitted=false}$('#opsModal').classList.add('hidden')}
    function openOpsModal(title,subtitle,html){$('#opsTitle').textContent=title;$('#opsSubtitle').textContent=subtitle||'';$('#opsBody').innerHTML=html;$('#opsModal').classList.remove('hidden')}


    function reportRide(report){const id=String(report.ride_id||report.trip_id||'');return rides.find(ride=>String(ride.id)===id)||null}
    function normalizeReport(raw,derived=false){
      const ride=derived?raw:reportRide(raw);
      const source=derived?{}:raw;
      return {
        ...source,
        id:source.id||`ride-${ride?.id||crypto.randomUUID()}`,
        ride_id:String(source.ride_id||source.trip_id||ride?.id||''),
        driver_id:String(source.driver_id||ride?.driver_id||''),
        driver_name:source.driver_name||ride?.driver_name||'Conductor sin nombre',
        passenger_id:String(source.passenger_id||ride?.passenger_id||''),
        passenger_name:source.passenger_name||ride?.passenger_name||'Pasajero',
        rating:Number(source.rating??ride?.rating??0),
        passenger_comment:source.passenger_comment??source.description??ride?.rating_comment??'',
        reviewed:Boolean(source.reviewed??(source.status==='resolved')),
        reviewed_at:source.reviewed_at||source.resolved_at||null,
        reviewed_by:source.reviewed_by||null,
        created_at:source.created_at||ride?.rated_at||ride?.created_at||new Date().toISOString(),
        updated_at:source.updated_at||source.created_at||ride?.updated_at||ride?.created_at||new Date().toISOString(),
        _derived:derived
      };
    }

    function buildReportList(databaseRows){
      const normalized=(databaseRows||[]).map(row=>normalizeReport(row,false));
      const knownRideIds=new Set(normalized.map(item=>item.ride_id).filter(Boolean));
      const missing=rides.filter(ride=>Number(ride.rating)>=1&&Number(ride.rating)<=3&&!knownRideIds.has(String(ride.id))).map(ride=>normalizeReport(ride,true));
      reports=[...normalized,...missing].sort((a,b)=>(safeDate(b.created_at)?.getTime()||0)-(safeDate(a.created_at)?.getTime()||0));
    }

    function reportGroups(){const map=new Map();reports.forEach(report=>{if(!report.driver_id)return;const group=map.get(report.driver_id)||{driver_id:report.driver_id,driver_name:report.driver_name,count:0,pending:0};group.count++;if(!report.reviewed)group.pending++;if(report.driver_name&&report.driver_name!=='Conductor sin nombre')group.driver_name=report.driver_name;map.set(report.driver_id,group)});return map}
    function riskForDriver(driverId){const count=reportGroups().get(String(driverId))?.count||0;return count>=5?'red':count>=3?'yellow':'green'}
    function riskLabel(level){return({green:'Verde',yellow:'Amarillo',red:'Rojo'})[level]||'Verde'}

    $('#loginBtn').onclick=login;
    $('#adminCode').addEventListener('keydown',event=>{if(event.key==='Enter')login()});
    function login(){
      if($('#adminCode').value!==DEV_CODE)return toast('Código incorrecto');
      const email=$('#adminEmail').value.trim()||'Propietario';
      localStorage.setItem('sr_admin_beta','1');
      localStorage.setItem('sr_admin_email',email);
      $('#ownerName').textContent=email;
      openApp();startPeriodicRefresh();
    }
    $('#logoutBtn').onclick=()=>{localStorage.removeItem('sr_admin_beta');localStorage.removeItem('sr_admin_email');location.reload()};

    async function openApp(){
      $('#login').classList.add('hidden');
      $('#app').classList.remove('hidden');
      $('#ownerName').textContent=ownerIdentity();
      await loadAll();
      setupRealtime();
    }

    $$('.nav-btn[data-page]').forEach(button=>button.onclick=()=>showPage(button.dataset.page));
    $$('[data-go]').forEach(button=>button.onclick=()=>showPage(button.dataset.go));
    function showPage(page){
      $$('.nav-btn[data-page]').forEach(button=>button.classList.toggle('active',button.dataset.page===page));
      $$('.section-page').forEach(section=>section.classList.toggle('active',section.id==='page-'+page));
      $('#pageTitle').textContent=({dashboard:'Resumen general',rides:'Gestión de viajes',drivers:'Conductores',passengers:'Pasajeros',fares:'Tarifas',reports:'Reportes de conductores'})[page]||'Sobre Ruedas';
      $('#sidebar').classList.remove('open');
    }
    $('#menuBtn').onclick=()=>$('#sidebar').classList.toggle('open');
    $('#refreshBtn').onclick=refreshOperations;
    $('#refreshReports').onclick=refreshOperations;

    async function loadRides(){
      const {data,error}=await sb.from('rides').select('*').order('created_at',{ascending:false}).limit(1000);
      if(error){console.error(error);toast('No se pudieron cargar los viajes');return false}
      rides=data||[];
      return true;
    }
    async function loadReports(){
      const {data,error}=await sb.from('driver_reports').select('*').order('created_at',{ascending:false}).limit(1000);
      reportsTableAvailable=!error;
      if(error)console.warn('driver_reports no disponible:',error.message);
      buildReportList(error?[]:data);
      return !error;
    }
    async function loadProfiles(){
      const {data,error}=await sb.from('profiles').select('*').order('created_at',{ascending:false}).limit(2000);
      profilesTableAvailable=!error;
      if(error){console.warn('profiles no disponible:',error.message);profiles=[];return false}
      profiles=data||[];
      return true;
    }
    async function loadFares(){
      const defaults=[['Motorina',0,38,0],['Moto',0,45,0],['Bicitaxi',0,28,0],['Triciclo',0,48,0]];
      const {data,error}=await sb.from('fare_settings').select('*').order('vehicle_type');
      fareTableAvailable=!error;
      if(error)console.warn('fare_settings no disponible:',error.message);
      fares=data?.length?data:defaults.map(item=>({vehicle_type:item[0],base_fare:item[1],per_km:item[2],minimum_fare:item[3],active:true}));
    }
    async function loadAll(){
      setSyncState(false,'Cargando datos…');
      try{
        const [ridesOk]=await Promise.all([loadRides(),loadProfiles(),loadFares()]);
        if(ridesOk)await loadReports();
        lastPeopleUpdate=new Date();
        renderAll();
        setSyncState(true,'Datos actualizados');
      }catch(error){console.error(error);setSyncState(false,'Error al actualizar');toast('No se pudieron actualizar todos los datos')}
    }
    async function refreshOperations(){
      if(refreshOperations.running)return;
      refreshOperations.running=true;
      document.body.classList.add('refreshing');
      setSyncState(false,'Actualizando…');
      try{
        const [ridesOk]=await Promise.all([loadRides(),loadProfiles(),loadFares()]);
        if(ridesOk)await loadReports();
        lastPeopleUpdate=new Date();
        renderAll(false);
        setSyncState(true,'Conectado en tiempo real');
      }catch(error){console.error(error);setSyncState(false,'Error al actualizar')}
      finally{refreshOperations.running=false;document.body.classList.remove('refreshing')}
    }
    function setSyncState(connected,text){$('#syncDot').classList.toggle('offline',!connected);$('#syncText').textContent=text}

    function renderAll(includeFares=true){renderDashboard();renderRideTable();renderPeople();renderReports();if(includeFares)renderFares();if(liveMap&&$('#liveMap'))renderLiveMap(false)}
    function renderDashboard(){
      const todayRides=rides.filter(isToday);
      const activeRides=rides.filter(ride=>ACTIVE_STATUSES.includes(ride.status));
      const finishedToday=rides.filter(ride=>ride.status==='finished'&&localDateKey(ride.finished_at||ride.updated_at||ride.created_at)===todayKey());
      const canceledToday=rides.filter(ride=>ride.status==='canceled'&&localDateKey(ride.canceled_at||ride.updated_at||ride.created_at)===todayKey());
      const activeDrivers=activeDriverIds();
      const groups=[...reportGroups().values()];
      $('#sDrivers').textContent=activeDrivers.size;
      $('#sActive').textContent=activeRides.length;
      $('#sSearching').textContent=todayRides.filter(ride=>ride.status==='searching').length;
      $('#sFinished').textContent=finishedToday.length;
      $('#sCanceled').textContent=canceledToday.length;
      $('#sRevenue').textContent=money(finishedToday.reduce((sum,ride)=>sum+Number(ride.price||0),0));
      $('#sReports').textContent=reports.filter(report=>!report.reviewed).length;
      $('#sRepeat').textContent=groups.filter(group=>group.count>=3).length;
      renderRows(activeRides.slice(0,10),'#liveRows',true);
      renderAlerts();
    }

    function setRideView(filter,date=''){
      rideFilter=filter;
      $$('#rideFilters button').forEach(button=>button.classList.toggle('active',button.dataset.filter===filter));
      $('#rideDate').value=date;
      showPage('rides');
      renderRideTable();
      window.scrollTo({top:0,behavior:'smooth'});
    }
    function driverLocation(driverId){
      const profile=profileFor(driverId);
      if(Number.isFinite(Number(profile?.last_lat))&&Number.isFinite(Number(profile?.last_lng)))return {lat:Number(profile.last_lat),lng:Number(profile.last_lng),source:'GPS del perfil'};
      const ride=latestRideForDriver(driverId);
      if(Number.isFinite(Number(ride?.driver_lat))&&Number.isFinite(Number(ride?.driver_lng)))return {lat:Number(ride.driver_lat),lng:Number(ride.driver_lng),source:'Último viaje'};
      return null;
    }
    function activeDriverPeople(){
      const ids=activeDriverIds();
      return uniquePeople('driver').filter(person=>ids.has(person.id));
    }
    function openActiveDrivers(){
      const list=activeDriverPeople();
      const html=`<div class="ops-summary"><div class="ops-kpi"><small>ACTIVOS AHORA</small><strong>${list.length}</strong></div><div class="ops-kpi"><small>APROBADOS</small><strong>${list.filter(item=>item.approval_status==='approved').length}</strong></div></div><div class="ops-list">${list.map(person=>opsDriverItem(person)).join('')||'<div class="empty">No hay conductores activos en este momento.</div>'}</div>`;
      openOpsModal('Conductores activos','Lista en tiempo real con acciones administrativas',html);
    }
    function opsDriverItem(person){
      const loc=driverLocation(person.id);
      return `<div class="ops-item"><div><strong>${esc(person.name||'Sin nombre')}</strong> <span class="approval approval-${approvalClass(person.approval_status)}">${approvalLabel(person.approval_status)}</span><p>${esc(person.vehicle||'Vehículo sin definir')} · ${person.trips} viaje(s)${loc?' · ubicación disponible':' · sin GPS reciente'}</p></div><div class="ops-actions"><button class="neutral" data-ops-action="trips" data-person-id="${esc(person.id)}">Viajes</button><button class="ok" data-ops-action="approve" data-person-id="${esc(person.id)}">Aprobar</button><button class="warning" data-ops-action="reject" data-person-id="${esc(person.id)}">Desaprobar</button><button class="danger" data-ops-action="delete-driver" data-person-id="${esc(person.id)}">Eliminar</button></div></div>`;
    }
    function mapIcon(kind,emoji){
      return L.divIcon({className:'',html:`<div class="map-marker ${kind}"><span>${emoji}</span></div>`,iconSize:[34,34],iconAnchor:[17,32],popupAnchor:[0,-30]});
    }
    function validPoint(lat,lng){return Number.isFinite(Number(lat))&&Number.isFinite(Number(lng))&&Math.abs(Number(lat))<=90&&Math.abs(Number(lng))<=180}
    function openLiveMap(){
      const drivers=activeDriverPeople();
      const searching=rides.filter(ride=>ride.status==='searching');
      const activeTrips=rides.filter(ride=>['accepted','arrived','in_progress'].includes(ride.status));
      const controls=`<div class="map-toolbar"><button class="active" data-map-filter="drivers">Conductores</button><button class="active" data-map-filter="requests">Solicitudes</button><button class="active" data-map-filter="trips">Viajes activos</button><button data-map-action="center">Centrar</button><button data-map-action="refresh">Actualizar</button></div>`;
      const html=`${controls}<div class="live-map-layout"><div class="live-map-shell"><div id="liveMap" class="live-map"></div><div id="liveMapEmpty" class="map-empty hidden"><div>No hay ubicaciones GPS disponibles todavía.<br>Los conductores aparecerán al conectarse.</div></div><div class="map-legend"><span><i class="legend-dot legend-driver"></i> Conductores</span><span><i class="legend-dot legend-request"></i> Solicitudes</span><span><i class="legend-dot legend-trip"></i> Viajes en curso</span></div></div><div id="liveMapSide" class="live-map-side"></div></div>`;
      openOpsModal('Mapa operativo en vivo',`${drivers.length} conductor(es) · ${searching.length} solicitud(es) · ${activeTrips.length} viaje(s)`,html);
      setTimeout(()=>{
        if(!window.L||!$('#liveMap'))return toast('No se pudo cargar el mapa');
        liveMap=L.map('liveMap',{zoomControl:true}).setView([21.84206,-78.76000],13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; OpenStreetMap'}).addTo(liveMap);
        liveMapLayers={drivers:L.layerGroup().addTo(liveMap),requests:L.layerGroup().addTo(liveMap),trips:L.layerGroup().addTo(liveMap)};
        renderLiveMap(true);
        setTimeout(()=>liveMap?.invalidateSize(),150);
      },50);
    }
    function renderLiveMap(fit=true){
      if(!liveMap||!liveMapLayers)return;
      Object.values(liveMapLayers).forEach(layer=>layer.clearLayers());
      const bounds=[];
      const drivers=activeDriverPeople();
      const searching=rides.filter(ride=>ride.status==='searching');
      const activeTrips=rides.filter(ride=>['accepted','arrived','in_progress'].includes(ride.status));
      if(liveMapFilters.drivers){
        drivers.forEach(person=>{const loc=driverLocation(person.id);if(!loc||!validPoint(loc.lat,loc.lng))return;const marker=L.marker([loc.lat,loc.lng],{icon:mapIcon('driver','🛵')}).addTo(liveMapLayers.drivers);marker.bindPopup(`<strong>${esc(person.name||'Conductor')}</strong><br>${esc(person.vehicle||'Vehículo')}<br>${person.is_online?'En línea':'En viaje'} · ${esc(loc.source)}<br><button onclick="window.adminOpenTrips('${esc(person.id)}')" style="margin-top:7px">Ver viajes</button>`);bounds.push([loc.lat,loc.lng])});
      }
      if(liveMapFilters.requests){
        searching.forEach(ride=>{if(!validPoint(ride.pickup_lat,ride.pickup_lng))return;const lat=Number(ride.pickup_lat),lng=Number(ride.pickup_lng);L.marker([lat,lng],{icon:mapIcon('request','🙋')}).addTo(liveMapLayers.requests).bindPopup(`<strong>Solicitud buscando conductor</strong><br>${esc(ride.passenger_name||'Pasajero')}<br>${esc(ride.pickup_address||'Recogida')}<br>Destino: ${esc(ride.destination_address||'—')}`);bounds.push([lat,lng])});
      }
      if(liveMapFilters.trips){
        activeTrips.forEach(ride=>{const points=[];if(validPoint(ride.driver_lat,ride.driver_lng))points.push([Number(ride.driver_lat),Number(ride.driver_lng)]);else{const loc=driverLocation(ride.driver_id);if(loc)points.push([loc.lat,loc.lng])}if(validPoint(ride.pickup_lat,ride.pickup_lng))points.push([Number(ride.pickup_lat),Number(ride.pickup_lng)]);if(validPoint(ride.destination_lat,ride.destination_lng))points.push([Number(ride.destination_lat),Number(ride.destination_lng)]);if(!points.length)return;const main=points[0];L.marker(main,{icon:mapIcon('trip','🚕')}).addTo(liveMapLayers.trips).bindPopup(`<strong>Viaje ${esc(statusLabel(ride.status))}</strong><br>${esc(ride.driver_name||'Sin conductor')} · ${esc(ride.passenger_name||'Pasajero')}<br>${esc(ride.pickup_address||'Recogida')} → ${esc(ride.destination_address||'Destino')}`);if(points.length>1)L.polyline(points,{color:'#2563eb',weight:4,opacity:.65,dashArray:'7,7'}).addTo(liveMapLayers.trips);points.forEach(point=>bounds.push(point))});
      }
      const missing=drivers.filter(person=>!driverLocation(person.id)).length;
      const side=$('#liveMapSide');
      if(side)side.innerHTML=`<div class="ops-summary"><div class="ops-kpi"><small>CONDUCTORES</small><strong>${drivers.length}</strong></div><div class="ops-kpi"><small>SIN GPS</small><strong>${missing}</strong></div></div>${drivers.map(person=>{const loc=driverLocation(person.id);return `<div class="radar-driver"><strong>${esc(person.name||'Sin nombre')}</strong><small>${esc(person.vehicle||'Vehículo')} · ${loc?'GPS actualizado '+dateFmt(person.profile?.last_seen_at||person.last):'Sin ubicación reciente'}</small><div class="ops-actions" style="margin-top:8px"><button class="neutral" data-ops-action="trips" data-person-id="${esc(person.id)}">Viajes</button><button class="warning" data-ops-action="reject" data-person-id="${esc(person.id)}">Bloquear</button><button class="danger" data-ops-action="delete-driver" data-person-id="${esc(person.id)}">Eliminar</button></div></div>`}).join('')||'<div class="empty">No hay conductores activos.</div>'}`;
      $('#liveMapEmpty')?.classList.toggle('hidden',bounds.length>0);
      $('#opsSubtitle').textContent=`${drivers.length} conductor(es) · ${searching.length} solicitud(es) · ${activeTrips.length} viaje(s) · actualización ${new Date().toLocaleTimeString('es-US',{hour:'numeric',minute:'2-digit',second:'2-digit'})}`;
      if(bounds.length&&(fit||!liveMapHasFitted)){liveMap.fitBounds(bounds,{padding:[40,40],maxZoom:15});liveMapHasFitted=true}
    }
    window.adminOpenTrips=id=>openPersonTrips(id,'driver');
    function openRevenue(){
      const finished=rides.filter(ride=>ride.status==='finished'&&localDateKey(ride.finished_at||ride.updated_at||ride.created_at)===todayKey());
      const total=finished.reduce((sum,ride)=>sum+Number(ride.price||0),0);
      const byVehicle=new Map();finished.forEach(ride=>byVehicle.set(ride.vehicle_type||'Sin vehículo',(byVehicle.get(ride.vehicle_type||'Sin vehículo')||0)+Number(ride.price||0)));
      const html=`<div class="ops-summary"><div class="ops-kpi"><small>VOLUMEN TOTAL</small><strong>${money(total)}</strong></div><div class="ops-kpi"><small>VIAJES TERMINADOS</small><strong>${finished.length}</strong></div><div class="ops-kpi"><small>PROMEDIO</small><strong>${money(finished.length?total/finished.length:0)}</strong></div></div><div class="ops-list">${[...byVehicle.entries()].map(([vehicle,value])=>`<div class="ops-item"><div><strong>${esc(vehicle)}</strong><p>Ingresos generados hoy</p></div><strong>${money(value)}</strong></div>`).join('')||'<div class="empty">Todavía no hay viajes terminados hoy.</div>'}</div>`;
      openOpsModal('Volumen de hoy','Desglose de viajes terminados',html);
    }
    function openRepeatDrivers(){
      const groups=[...reportGroups().values()].filter(group=>group.count>=3).sort((a,b)=>b.count-a.count);
      const html=`<div class="ops-list">${groups.map(group=>{const person=uniquePeople('driver').find(item=>item.id===group.driver_id)||{id:group.driver_id,name:group.driver_name,vehicle:'Vehículo sin definir',approval_status:profileFor(group.driver_id)?.approval_status||'pending',trips:0};return `<div class="ops-item"><div><strong>${esc(group.driver_name)}</strong> <span class="risk risk-${riskForDriver(group.driver_id)}">${riskLabel(riskForDriver(group.driver_id))}</span><p>${group.count} reporte(s) · ${group.pending} pendiente(s)</p></div><div class="ops-actions"><button class="neutral" data-ops-action="reports" data-person-id="${esc(group.driver_id)}">Reportes</button><button class="warning" data-ops-action="reject" data-person-id="${esc(group.driver_id)}">Desaprobar</button><button class="danger" data-ops-action="delete-driver" data-person-id="${esc(group.driver_id)}">Eliminar</button></div></div>`}).join('')||'<div class="empty">No hay conductores reincidentes.</div>'}</div>`;
      openOpsModal('Conductores reincidentes','Tres o más calificaciones bajas',html);
    }
    function handleStatAction(action){
      if(action==='active-drivers')return openActiveDrivers();
      if(action==='active-rides')return setRideView('active');
      if(action==='radar')return openLiveMap();
      if(action==='finished')return setRideView('finished',todayKey());
      if(action==='canceled')return setRideView('canceled',todayKey());
      if(action==='revenue')return openRevenue();
      if(action==='pending-reports'){showPage('reports');$('#reportStatus').value='pending';renderReports();return}
      if(action==='repeat-drivers')return openRepeatDrivers();
    }
    $$('.stat[data-stat-action]').forEach(card=>{card.onclick=()=>handleStatAction(card.dataset.statAction);card.onkeydown=event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();handleStatAction(card.dataset.statAction)}}});

    function renderRows(list,target,compact=false){
      const emptyColumns=compact?6:8;
      $(target).innerHTML=list.map(ride=>compact?`<tr><td><strong>#${esc(String(ride.id).slice(0,6))}</strong></td><td>${esc(ride.passenger_name)}</td><td>${esc(ride.driver_name||'Sin asignar')}</td><td><strong>${esc(ride.pickup_address)}</strong><br><small>→ ${esc(ride.destination_address)}</small></td><td><span class="status ${statusClass(ride.status)}">${esc(statusLabel(ride.status))}</span></td><td>${money(ride.price)}</td></tr>`:`<tr><td>${dateFmt(ride.created_at)}</td><td><strong>${esc(ride.passenger_name)}</strong></td><td>${esc(ride.driver_name||'Sin asignar')}</td><td>${esc(ride.pickup_address)}</td><td>${esc(ride.destination_address)}</td><td>${esc(ride.vehicle_type)}</td><td><span class="status ${statusClass(ride.status)}">${esc(statusLabel(ride.status))}</span></td><td><strong>${money(ride.price)}</strong></td></tr>`).join('')||`<tr><td colspan="${emptyColumns}" class="empty">No hay viajes para mostrar.</td></tr>`;
    }
    function renderRideTable(){
      let list=rideFilter==='all'?rides:rideFilter==='active'?rides.filter(ride=>ACTIVE_STATUSES.includes(ride.status)):rides.filter(ride=>ride.status===rideFilter);
      const query=$('#rideSearch').value.toLowerCase().trim();
      const date=$('#rideDate').value;
      if(query)list=list.filter(ride=>[ride.passenger_name,ride.driver_name,ride.passenger_id,ride.driver_id,ride.pickup_address,ride.destination_address,ride.vehicle_type,ride.id].some(value=>String(value||'').toLowerCase().includes(query)));
      if(date)list=list.filter(ride=>localDateKey(rideFilter==='finished'?(ride.finished_at||ride.created_at):rideFilter==='canceled'?(ride.canceled_at||ride.created_at):ride.created_at)===date);
      renderRows(list,'#rideRows');
    }
    $$('#rideFilters button').forEach(button=>button.onclick=()=>{rideFilter=button.dataset.filter;$$('#rideFilters button').forEach(item=>item.classList.toggle('active',item===button));renderRideTable()});
    $('#rideSearch').oninput=renderRideTable;
    $('#rideDate').onchange=renderRideTable;

    function uniquePeople(type){
      const map=new Map();
      profiles.filter(profile=>profile.role===type).forEach(profile=>{
        const key=profileKey(profile);if(!key)return;
        map.set(key,{id:key,profile_id:profile.id,name:profile.full_name||profile.email||profile.phone||'Sin nombre',trips:0,total:0,canceled:0,last:profile.last_seen_at||profile.updated_at||profile.created_at,photo:profile.photo_url||null,vehicle:profile.vehicle_type||null,ratingSum:0,ratingCount:0,approval_status:profile.approval_status||(type==='driver'?'pending':'approved'),status:profile.status||'active',is_online:isProfileOnline(profile),profile});
      });
      rides.forEach(ride=>{
        const rawId=ride[type+'_id'];if(!rawId)return;
        const profile=profileFor(rawId);const key=profile?profileKey(profile):String(rawId);
        const item=map.get(key)||{id:key,profile_id:profile?.id||null,name:ride[type+'_name']||'Sin nombre',trips:0,total:0,canceled:0,last:null,photo:profile?.photo_url||null,vehicle:profile?.vehicle_type||null,ratingSum:0,ratingCount:0,approval_status:profile?.approval_status||(type==='driver'?'pending':'approved'),status:profile?.status||'active',is_online:isProfileOnline(profile),profile};
        item.trips++;
        if(ride.status==='finished')item.total+=Number(ride.price||0);
        if(ride.status==='canceled')item.canceled++;
        if(!item.last||(safeDate(ride.updated_at||ride.created_at)?.getTime()||0)>(safeDate(item.last)?.getTime()||0))item.last=ride.updated_at||ride.created_at;
        if(type==='driver'){
          item.photo=ride.driver_photo||item.photo;item.vehicle=ride.vehicle_type||item.vehicle;
          const rating=Number(ride.rating);if(rating>=1&&rating<=5){item.ratingSum+=rating;item.ratingCount++}
          if(ride.driver_name)item.name=ride.driver_name;
          item.is_online=item.is_online||ACTIVE_STATUSES.includes(ride.status);
        }else if(ride.passenger_name)item.name=ride.passenger_name;
        map.set(key,item);
      });
      return [...map.values()].sort((a,b)=>String(a.name||'').localeCompare(String(b.name||''),'es'));
    }
    function personCard(person,type){
      const reportCount=type==='driver'?(reportGroups().get(person.id)?.count||0):0;
      const level=type==='driver'?riskForDriver(person.id):'green';
      const average=person.ratingCount?person.ratingSum/person.ratingCount:null;
      const photo=person.photo?`<img src="${esc(person.photo)}" alt="Foto">`:(type==='driver'?'🛵':'👤');
      const approval=type==='driver'?(person.approval_status||'pending'):(person.status==='deleted'?'deleted':'approved');
      const deleted=person.status==='deleted'||approval==='deleted';
      const cardClass=deleted?' deleted-card':approval==='rejected'?' blocked':approval==='pending'?' pending-card':'';
      let actions='';
      if(type==='driver'){
        actions=deleted?`<div class="actions wrap"><button class="ok" data-person-action="restore-driver" data-person-id="${esc(person.id)}">Restaurar conductor</button><button class="neutral" data-person-action="trips" data-person-id="${esc(person.id)}">Historial</button></div>`:`<div class="actions wrap"><button class="neutral" data-person-action="trips" data-person-id="${esc(person.id)}">Viajes</button><button class="neutral" data-person-action="reports" data-person-id="${esc(person.id)}">Reportes</button><button class="ok" data-person-action="approve" data-person-id="${esc(person.id)}">Aprobar</button><button class="warning" data-person-action="reject" data-person-id="${esc(person.id)}">Desaprobar</button><button class="danger" data-person-action="delete-driver" data-person-id="${esc(person.id)}">Eliminar</button></div>`;
      }else{
        actions=deleted?`<div class="actions wrap"><button class="ok" data-person-action="restore-passenger" data-person-id="${esc(person.id)}">Restaurar usuario</button><button class="neutral" data-person-action="trips" data-person-id="${esc(person.id)}">Historial</button></div>`:`<div class="actions wrap"><button class="neutral" data-person-action="trips" data-person-id="${esc(person.id)}">Viajes</button><button class="danger" data-person-action="delete-passenger" data-person-id="${esc(person.id)}">Eliminar</button></div>`;
      }
      const reason=person.profile?.deleted_reason||person.profile?.rejection_reason||'';
      return `<article class="person${cardClass}" data-person-id="${esc(person.id)}" data-status="${esc(deleted?'deleted':approval)}" data-online="${person.is_online?'1':'0'}"><div class="person-top"><div class="avatar">${photo}</div><div><strong>${esc(person.name||'Sin nombre')}</strong><br><small>${type==='driver'?esc(person.vehicle||'Vehículo sin definir'):'Usuario registrado'}</small><br><span class="approval approval-${approvalClass(approval)}">${approvalLabel(approval)}</span>${type==='driver'&&person.is_online?' <span class="status in_progress">En línea</span>':''}${reason?`<div class="admin-reason">Motivo: ${esc(reason)}</div>`:''}</div></div><div class="meta"><div><small>Viajes</small><b>${person.trips}</b></div><div><small>${type==='driver'?'Ganado':'Gastado'}</small><b>${money(person.total)}</b></div><div><small>Cancelados</small><b>${person.canceled}</b></div><div><small>${type==='driver'?'Promedio':'Última actividad'}</small><b>${type==='driver'?(average?'⭐ '+average.toFixed(1):'Sin evaluar'):dateFmt(person.last)}</b></div>${type==='driver'?`<div><small>Reportes</small><b>${reportCount}</b></div><div><small>Riesgo</small><b><span class="risk risk-${level}">${riskLabel(level)}</span></b></div>`:''}</div><div class="profile-id">ID: ${esc(person.id)}</div>${actions}</article>`;
    }
    function renderPeople(){
      const drivers=uniquePeople('driver');const passengers=uniquePeople('passenger');
      $('#driverCards').innerHTML=drivers.map(person=>personCard(person,'driver')).join('')||'<div class="empty">Aún no hay conductores registrados o con viajes.</div>';
      $('#passengerCards').innerHTML=passengers.map(person=>personCard(person,'passenger')).join('')||'<div class="empty">Aún no hay usuarios registrados o con viajes.</div>';
      $('#driverCount').textContent=drivers.length;$('#passengerCount').textContent=passengers.length;
      const stamp=lastPeopleUpdate?lastPeopleUpdate.toLocaleTimeString('es-US',{hour:'numeric',minute:'2-digit',second:'2-digit'}):'Sin actualizar';
      $('#driverUpdated').textContent='Actualizado '+stamp;$('#passengerUpdated').textContent='Actualizado '+stamp;
      applyPeopleFilters('driver');applyPeopleFilters('passenger');
    }
    function applyPeopleFilters(type){
      const query=$('#'+type+'Search').value.toLowerCase().trim();
      const status=$('#'+type+'Status').value;
      $$(`#${type}Cards .person`).forEach(card=>{
        const text=card.textContent.toLowerCase();const cardStatus=card.dataset.status;const online=card.dataset.online==='1';
        let ok=!query||text.includes(query);
        if(type==='driver'&&status!=='all'){if(status==='online')ok=ok&&online;else ok=ok&&cardStatus===status}
        if(type==='passenger'&&status!=='all')ok=ok&&(status==='deleted'?cardStatus==='deleted':cardStatus!=='deleted');
        card.classList.toggle('hidden',!ok);
      });
    }
    async function ensureProfile(personId,role='driver'){
      const key=String(personId||'').trim();
      if(!key){toast('Identificador de perfil inválido');return null}
      let profile=profileFor(key);if(profile)return profile;

      const {data:stored,error:readError}=await sb.from('profiles').select('*').eq('device_id',key).maybeSingle();
      if(readError){console.error('Error consultando perfil:',readError);toast('No se pudo consultar el perfil: '+(readError.message||'error de Supabase'));return null}
      if(stored){profiles=[stored,...profiles.filter(item=>profileKey(item)!==key)];return stored}

      const person=uniquePeople(role).find(item=>item.id===key);
      const payload={device_id:key,role,full_name:person?.name||null,status:'active',vehicle_type:person?.vehicle||null,approval_status:role==='driver'?'pending':'approved',is_online:false,updated_at:new Date().toISOString()};
      let {data,error}=await sb.from('profiles').insert(payload).select().single();

      // Si otro proceso creó el perfil al mismo tiempo, se recupera en vez de fallar.
      if(error&&error.code==='23505'){
        const retry=await sb.from('profiles').select('*').eq('device_id',key).maybeSingle();
        data=retry.data;error=retry.error;
      }
      if(error||!data){console.error('Error creando perfil:',error);toast('No se pudo crear el perfil del conductor: '+(error?.message||'respuesta vacía'));return null}
      profiles=[data,...profiles.filter(item=>profileKey(item)!==key)];return data;
    }
    async function logAdminAction(action,targetId,targetRole,reason,metadata={}){
      const payload={action,target_id:String(targetId),target_role:targetRole,reason:reason||null,admin_name:ownerIdentity(),metadata,created_at:new Date().toISOString()};
      const {error}=await sb.from('admin_action_log').insert(payload);if(error)console.warn('No se pudo registrar auditoría:',error.message);
    }
    async function setDriverApproval(personId,approval){
      const profile=await ensureProfile(personId,'driver');if(!profile)return;
      let reason=null;
      if(approval==='rejected'){reason=prompt('Escribe el motivo de la desaprobación o bloqueo:','Documentación pendiente o no válida');if(reason===null)return;reason=reason.trim();if(!reason)return toast('El motivo es obligatorio')}
      const approved=approval==='approved';
      const payload={approval_status:approval,status:approved?'active':'blocked',is_online:approved?Boolean(profile.is_online):false,approved_at:approved?new Date().toISOString():null,approved_by:approved?ownerIdentity():null,rejection_reason:approved?null:reason,updated_at:new Date().toISOString()};
      const {error}=await sb.from('profiles').update(payload).eq('id',profile.id);
      if(error){console.error(error);return toast('No se pudo actualizar el conductor. Ejecuta SQL v2.4.2')}
      await logAdminAction(approved?'approve_driver':'reject_driver',personId,'driver',reason);
      toast(approved?'Conductor aprobado':'Conductor desaprobado y bloqueado');if(!$('#opsModal').classList.contains('hidden'))closeOpsModal();await refreshOperations();
    }
    async function deleteDriver(personId){
      const person=uniquePeople('driver').find(item=>item.id===String(personId));
      const name=person?.name||'este conductor';
      const reason=prompt(`Escribe el motivo para eliminar a ${name}:`,'Incumplimiento de las normas de la plataforma');
      if(reason===null)return;if(!reason.trim())return toast('El motivo de eliminación es obligatorio');
      if(!confirm(`CONFIRMACIÓN FINAL

¿Eliminar a ${name} de la plataforma?

No podrá iniciar sesión ni aceptar viajes. El historial se conservará.`))return;
      const profile=await ensureProfile(personId,'driver');if(!profile)return;
      const driverKeys=new Set([String(personId),String(profile.id||''),String(profile.device_id||'')]);
      const active=rides.filter(ride=>driverKeys.has(String(ride.driver_id||''))&&['accepted','arrived','in_progress'].includes(ride.status));
      if(active.length){if(!confirm(`Este conductor tiene ${active.length} viaje(s) activo(s). ¿Cancelarlos y continuar con la eliminación?`))return;const {error:rideError}=await sb.from('rides').update({status:'canceled',canceled_at:new Date().toISOString(),canceled_by:'admin',updated_at:new Date().toISOString()}).in('id',active.map(ride=>ride.id));if(rideError){console.error(rideError);return toast('No se pudieron cancelar los viajes activos')}}
      const now=new Date().toISOString();
      const {error}=await sb.from('profiles').update({status:'deleted',approval_status:'deleted',is_online:false,deleted_at:now,deleted_reason:reason.trim(),deleted_by:ownerIdentity(),updated_at:now}).eq('id',profile.id);
      if(error){console.error(error);return toast('No se pudo eliminar el conductor')}
      await logAdminAction('delete_driver',personId,'driver',reason.trim(),{active_rides_canceled:active.length});
      toast('Conductor eliminado y acceso bloqueado');closeOpsModal();await refreshOperations();
    }
    async function restoreDriver(personId){
      const profile=await ensureProfile(personId,'driver');if(!profile)return;
      if(!confirm('¿Restaurar este conductor como pendiente de aprobación?'))return;
      const {error}=await sb.from('profiles').update({status:'active',approval_status:'pending',is_online:false,deleted_at:null,deleted_reason:null,deleted_by:null,updated_at:new Date().toISOString()}).eq('id',profile.id);
      if(error)return toast('No se pudo restaurar el conductor');await logAdminAction('restore_driver',personId,'driver','Restaurado por administración');toast('Conductor restaurado como pendiente');await refreshOperations();
    }
    async function deletePassenger(personId){
      const person=uniquePeople('passenger').find(item=>item.id===String(personId));
      const reason=prompt(`Motivo para eliminar a ${person?.name||'este usuario'}:`,'Solicitud administrativa');if(reason===null)return;if(!reason.trim())return toast('El motivo es obligatorio');
      if(!confirm(`¿Eliminar a ${person?.name||'este usuario'}? Sus viajes históricos se conservarán.`))return;
      const profile=await ensureProfile(personId,'passenger');if(!profile)return;
      const {error}=await sb.from('profiles').update({status:'deleted',approval_status:'deleted',is_online:false,deleted_at:new Date().toISOString(),deleted_reason:reason.trim(),deleted_by:ownerIdentity(),updated_at:new Date().toISOString()}).eq('id',profile.id);
      if(error){console.error(error);return toast('No se pudo eliminar el usuario')}
      await logAdminAction('delete_passenger',personId,'passenger',reason.trim());toast('Usuario eliminado');await refreshOperations();
    }
    async function restorePassenger(personId){
      const profile=await ensureProfile(personId,'passenger');if(!profile)return;
      const {error}=await sb.from('profiles').update({status:'active',approval_status:'approved',deleted_at:null,deleted_reason:null,deleted_by:null,updated_at:new Date().toISOString()}).eq('id',profile.id);
      if(error)return toast('No se pudo restaurar el usuario');await logAdminAction('restore_passenger',personId,'passenger','Restaurado por administración');toast('Usuario restaurado');await refreshOperations();
    }
    function openPersonTrips(personId,type='driver'){
      $('#rideSearch').value=String(personId);$('#rideDate').value='';rideFilter='all';$$('#rideFilters button').forEach(button=>button.classList.toggle('active',button.dataset.filter==='all'));showPage('rides');renderRideTable();closeOpsModal();
    }
    async function handlePersonAction(action,personId,type='driver'){
      if(action==='trips')return openPersonTrips(personId,type);
      if(action==='reports'){closeOpsModal();return openDriverReports(personId)}
      if(action==='approve')return setDriverApproval(personId,'approved');
      if(action==='reject')return setDriverApproval(personId,'rejected');
      if(action==='delete-driver')return deleteDriver(personId);
      if(action==='restore-driver')return restoreDriver(personId);
      if(action==='delete-passenger')return deletePassenger(personId);
      if(action==='restore-passenger')return restorePassenger(personId);
    }
    $('#driverCards').onclick=event=>{const button=event.target.closest('[data-person-action]');if(button)handlePersonAction(button.dataset.personAction,button.dataset.personId,'driver')};
    $('#passengerCards').onclick=event=>{const button=event.target.closest('[data-person-action]');if(button)handlePersonAction(button.dataset.personAction,button.dataset.personId,'passenger')};
    $('#driverSearch').oninput=()=>applyPeopleFilters('driver');
    $('#passengerSearch').oninput=()=>applyPeopleFilters('passenger');
    $('#driverStatus').onchange=()=>applyPeopleFilters('driver');
    $('#passengerStatus').onchange=()=>applyPeopleFilters('passenger');
    $('#refreshDrivers').onclick=refreshOperations;
    $('#refreshPassengers').onclick=refreshOperations;

    function renderAlerts(){
      const now=Date.now();
      const alerts=[];
      [...reportGroups().values()].filter(group=>group.count>=3).sort((a,b)=>b.count-a.count).forEach(group=>alerts.push({icon:group.count>=5?'🔴':'🟡',title:'Conductor reincidente',text:`${group.driver_name} acumula ${group.count} calificaciones bajas`}));
      reports.filter(report=>!report.reviewed&&report.rating===1).slice(0,3).forEach(report=>alerts.push({icon:'⭐',title:'Reporte crítico pendiente',text:`${report.driver_name} recibió 1 estrella`}));
      rides.filter(ride=>ride.status==='searching').forEach(ride=>{const minutes=Math.max(0,Math.round((now-(safeDate(ride.created_at)?.getTime()||now))/60000));if(minutes>=2)alerts.push({icon:'⏳',title:'Viaje sin conductor',text:`${ride.passenger_name||'Pasajero'} espera hace ${minutes} min`})});
      rides.filter(ride=>['accepted','arrived','in_progress'].includes(ride.status)).forEach(ride=>{const minutes=Math.max(0,Math.round((now-(safeDate(ride.updated_at||ride.created_at)?.getTime()||now))/60000));if(minutes>=30)alerts.push({icon:'📡',title:'Viaje sin actualización',text:`#${String(ride.id).slice(0,6)} lleva ${minutes} min`})});
      rides.filter(ride=>ride.status==='canceled'&&localDateKey(ride.canceled_at||ride.updated_at||ride.created_at)===todayKey()).slice(0,3).forEach(ride=>alerts.push({icon:'✕',title:'Cancelación reciente',text:`${ride.passenger_name||'Pasajero'} · ${ride.pickup_address||'Sin dirección'}`}));
      $('#alerts').innerHTML=alerts.slice(0,10).map(alert=>`<div class="alert"><div class="alert-icon">${alert.icon}</div><div><strong>${esc(alert.title)}</strong><small>${esc(alert.text)}</small></div></div>`).join('')||'<div class="empty">No hay alertas importantes.</div>';
    }

    function renderFares(){
      $('#fareGrid').innerHTML=fares.map(fare=>`<div class="fare-card" data-vehicle="${esc(fare.vehicle_type)}"><h3>${esc(fare.vehicle_type)}</h3><div class="fare-row"><span>Precio por km (CUP)</span><input data-k="per_km" type="number" min="0" step="1" value="${Number(fare.per_km||0)}"></div></div>`).join('');
      $('#saveFares').disabled=!fareTableAvailable;
      $('#saveFares').title=fareTableAvailable?'Guardar tarifas':'Ejecuta el SQL de actualización para habilitar tarifas';
    }
    $('#saveFares').onclick=async()=>{
      const rows=$$('.fare-card').map(card=>({vehicle_type:card.dataset.vehicle,base_fare:0,per_km:Number(card.querySelector('[data-k="per_km"]').value),minimum_fare:0,active:true,updated_at:new Date().toISOString()}));
      if(rows.some(row=>Object.values(row).some(value=>typeof value==='number'&&(!Number.isFinite(value)||value<0))))return toast('Revisa los valores de las tarifas');
      const {error}=await sb.from('fare_settings').upsert(rows,{onConflict:'vehicle_type'});
      if(error){console.error(error);return toast('No se pudieron guardar las tarifas')}
      fares=rows;toast('Tarifas actualizadas');
    };


    $('#opsBody').addEventListener('click',event=>{
      const filter=event.target.closest('[data-map-filter]');
      if(filter){const key=filter.dataset.mapFilter;liveMapFilters[key]=!liveMapFilters[key];filter.classList.toggle('active',liveMapFilters[key]);return renderLiveMap(false)}
      const action=event.target.closest('[data-map-action]');
      if(action?.dataset.mapAction==='refresh')return refreshOperations();
      if(action?.dataset.mapAction==='center'){liveMapHasFitted=false;return renderLiveMap(true)}
    });

    function renderReportDriverOptions(){
      const select=$('#reportDriver');
      const selected=select.value;
      const drivers=[...reportGroups().values()].sort((a,b)=>a.driver_name.localeCompare(b.driver_name,'es'));
      select.innerHTML='<option value="">Todos los conductores</option>'+drivers.map(driver=>`<option value="${esc(driver.driver_id)}">${esc(driver.driver_name)} (${driver.count})</option>`).join('');
      if(drivers.some(driver=>driver.driver_id===selected))select.value=selected;
    }
    function filteredReports(){
      const query=$('#reportSearch').value.toLowerCase().trim();
      const driver=$('#reportDriver').value;
      const rating=$('#reportRating').value;
      const status=$('#reportStatus').value;
      const date=$('#reportDate').value;
      return reports.filter(report=>{
        if(query&&![report.driver_name,report.passenger_name,report.passenger_comment,report.ride_id].some(value=>String(value||'').toLowerCase().includes(query)))return false;
        if(driver&&report.driver_id!==driver)return false;
        if(rating&&Number(report.rating)!==Number(rating))return false;
        if(status==='pending'&&report.reviewed)return false;
        if(status==='reviewed'&&!report.reviewed)return false;
        if(date&&localDateKey(report.created_at)!==date)return false;
        return true;
      });
    }
    function renderReports(){
      renderReportDriverOptions();
      const groups=[...reportGroups().values()];
      $('#rPending').textContent=reports.filter(report=>!report.reviewed).length;
      $('#rReviewed').textContent=reports.filter(report=>report.reviewed).length;
      $('#rRepeat').textContent=groups.filter(group=>group.count>=3).length;
      $('#rCritical').textContent=groups.filter(group=>group.count>=5).length;
      $('#reportWarning').classList.toggle('hidden',reportsTableAvailable);
      const list=filteredReports();
      $('#reportRows').innerHTML=list.map(report=>{
        const level=riskForDriver(report.driver_id);
        const action=report.reviewed?`<button class="row-action reopen" data-report-action="reopen" data-report-id="${esc(report.id)}">Reabrir</button>`:`<button class="row-action review" data-report-action="review" data-report-id="${esc(report.id)}">Resolver</button>`;
        return `<tr><td>${dateFmt(report.created_at)}</td><td><span class="risk risk-${level}">${riskLabel(level)}</span></td><td><strong>${esc(report.driver_name)}</strong><br><small>${reportGroups().get(report.driver_id)?.count||1} reporte(s)</small></td><td>${esc(report.passenger_name)}</td><td><span class="stars" title="${report.rating} de 5">${stars(report.rating)}</span><br><small>${report.rating}/5</small></td><td class="comment">${esc(report.passenger_comment||'Sin comentario')}</td><td><strong>#${esc(String(report.ride_id||'—').slice(0,8))}</strong></td><td><span class="status ${report.reviewed?'reviewed':'pending'}">${report.reviewed?'Revisado':'Pendiente'}</span>${report.reviewed_at?`<br><small>${dateFmt(report.reviewed_at)}</small>`:''}</td><td><div class="row-actions">${action}<button class="row-action history" data-report-action="history" data-driver-id="${esc(report.driver_id)}">Historial</button><button class="row-action neutral" data-report-action="ride" data-ride-id="${esc(report.ride_id)}">Ver viaje</button><button class="row-action report-delete" data-report-action="delete" data-report-id="${esc(report.id)}">Eliminar</button></div></td></tr>`;
      }).join('')||'<tr><td colspan="9" class="empty">No hay reportes que coincidan con los filtros.</td></tr>';
    }
    ['reportSearch','reportDriver','reportRating','reportStatus','reportDate'].forEach(id=>$('#'+id).addEventListener(id==='reportSearch'?'input':'change',renderReports));
    $('#clearReportFilters').onclick=()=>{['reportSearch','reportDriver','reportRating','reportStatus','reportDate'].forEach(id=>$('#'+id).value='');renderReports()};
    $('#reportRows').onclick=event=>{
      const button=event.target.closest('[data-report-action]');
      if(!button)return;
      if(button.dataset.reportAction==='history')return openDriverHistory(button.dataset.driverId);
      if(button.dataset.reportAction==='ride'){showPage('rides');$('#rideSearch').value=button.dataset.rideId;rideFilter='all';$$('#rideFilters button').forEach(item=>item.classList.toggle('active',item.dataset.filter==='all'));renderRideTable();return}
      if(button.dataset.reportAction==='delete')return deleteReport(button.dataset.reportId);
      setReportReviewed(button.dataset.reportId,button.dataset.reportAction==='review');
    };

    async function setReportReviewed(reportId,reviewed){
      const report=reports.find(item=>String(item.id)===String(reportId));
      if(!report)return toast('No se encontró el reporte');
      const now=new Date().toISOString();
      let error=null;
      if(report._derived){
        const payload={ride_id:report.ride_id||null,driver_id:report.driver_id||null,driver_name:report.driver_name||null,passenger_id:report.passenger_id||null,passenger_name:report.passenger_name||null,rating:report.rating,passenger_comment:report.passenger_comment||null,reviewed,reviewed_at:reviewed?now:null,reviewed_by:reviewed?ownerIdentity():null,risk_level:riskForDriver(report.driver_id),created_at:report.created_at||now,updated_at:now};
        ({error}=await sb.from('driver_reports').upsert(payload,{onConflict:'ride_id'}));
      }else{
        ({error}=await sb.from('driver_reports').update({reviewed,reviewed_at:reviewed?now:null,reviewed_by:reviewed?ownerIdentity():null,updated_at:now}).eq('id',report.id));
      }
      if(error){console.error(error);return toast('No se pudo guardar. Ejecuta el SQL v2.4.2 y vuelve a intentar')}
      toast(reviewed?'Reporte resuelto':'Reporte reabierto');
      await refreshOperations();
    }
    async function deleteReport(reportId){
      const report=reports.find(item=>String(item.id)===String(reportId));if(!report)return toast('No se encontró el reporte');
      if(!confirm('¿Eliminar este reporte? También se retirará la calificación baja del viaje para que no vuelva a generarse.'))return;
      let error=null;
      if(report.ride_id){({error}=await sb.from('rides').update({rating:null,rating_comment:null,rated_at:null}).eq('id',report.ride_id));if(error){console.error(error);return toast('No se pudo retirar la calificación del viaje')}}
      if(!report._derived){({error}=await sb.from('driver_reports').delete().eq('id',report.id));if(error){console.error(error);return toast('No se pudo eliminar el reporte. Ejecuta SQL v2.4.2')}}
      toast('Reporte eliminado');await refreshOperations();
    }

    function openDriverReports(driverId){showPage('reports');$('#reportDriver').value=String(driverId);renderReports();window.scrollTo({top:0,behavior:'smooth'})}
    function openDriverHistory(driverId){
      const list=reports.filter(report=>report.driver_id===String(driverId));
      const name=list[0]?.driver_name||'Conductor';
      const level=riskForDriver(driverId);
      $('#historyTitle').textContent=`Historial de ${name}`;
      $('#historySubtitle').textContent=`${list.length} reporte(s) · Riesgo ${riskLabel(level).toLowerCase()}`;
      $('#historyList').innerHTML=list.map(report=>`<div class="history-item"><div><small>Fecha</small><strong>${dateFmt(report.created_at)}</strong></div><div><span class="stars">${stars(report.rating)}</span><small>${report.rating}/5</small></div><div><strong>${esc(report.passenger_name)}</strong><p>${esc(report.passenger_comment||'Sin comentario')}</p></div><div><span class="status ${report.reviewed?'reviewed':'pending'}">${report.reviewed?'Revisado':'Pendiente'}</span></div></div>`).join('')||'<div class="empty">Este conductor no tiene reportes.</div>';
      $('#historyModal').classList.remove('hidden');
    }
    $('#closeHistory').onclick=()=>$('#historyModal').classList.add('hidden');
    $('#historyModal').onclick=event=>{if(event.target===$('#historyModal'))$('#historyModal').classList.add('hidden')};
    $('#closeOps').onclick=closeOpsModal;
    $('#opsModal').onclick=event=>{if(event.target===$('#opsModal'))closeOpsModal()};
    $('#opsBody').onclick=event=>{const button=event.target.closest('[data-ops-action]');if(button)handlePersonAction(button.dataset.opsAction,button.dataset.personId,'driver')};
    document.addEventListener('keydown',event=>{if(event.key==='Escape'){$('#historyModal').classList.add('hidden');closeOpsModal()}});

    function setupRealtime(){
      if(channel)sb.removeChannel(channel);
      channel=sb.channel('admin-v241').on('postgres_changes',{event:'*',schema:'public',table:'rides'},queueRefresh);
      if(reportsTableAvailable)channel.on('postgres_changes',{event:'*',schema:'public',table:'driver_reports'},queueRefresh);
      if(profilesTableAvailable)channel.on('postgres_changes',{event:'*',schema:'public',table:'profiles'},queueRefresh);
      channel.subscribe(status=>{
        if(status==='SUBSCRIBED')setSyncState(true,'Conectado en tiempo real');
        else if(status==='CHANNEL_ERROR'||status==='TIMED_OUT')setSyncState(false,'Conexión inestable');
        else setSyncState(false,'Conectando…');
      });
    }
    function queueRefresh(){clearTimeout(refreshTimer);refreshTimer=setTimeout(refreshOperations,250)}
    function startPeriodicRefresh(){clearInterval(periodicRefresh);periodicRefresh=setInterval(()=>{if(!document.hidden&&localStorage.getItem('sr_admin_beta'))refreshOperations()},10000)}
    window.addEventListener('online',()=>{setSyncState(false,'Reconectando…');refreshOperations();setupRealtime()});
    window.addEventListener('offline',()=>setSyncState(false,'Sin conexión'));
    document.addEventListener('visibilitychange',()=>{if(!document.hidden&&localStorage.getItem('sr_admin_beta'))refreshOperations()});
    window.addEventListener('beforeunload',()=>{if(channel)sb.removeChannel(channel);clearInterval(periodicRefresh)});

    if(localStorage.getItem('sr_admin_beta')){openApp();startPeriodicRefresh()}
  