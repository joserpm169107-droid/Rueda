  $('#pickupText').textContent='Parque José Martí, Ciego de Ávila';
  clearRoute();
  toast('Ubicación restaurada al Parque José Martí');
}
$('#searchAddressBtn').onclick=async()=>{
  const btn=$('#searchAddressBtn');
  routeRequestId++;
  destinationPoint=null;pendingDestination=null;
  $('#confirmLocation').classList.remove('show');
  clearRoute();
  btn.disabled=true;btn.textContent='⏳ Buscando…';
  try{const ok=await prepareRealRoute();if(ok)toast('Dirección y ruta listas')}
  finally{btn.disabled=false;btn.textContent='🔎 Buscar dirección cubana'}
}
$('#pickMapBtn').onclick=()=>startPinMode('destination');
$('#fixLocationBtn').onclick=()=>{ $('#confirmLocation').classList.remove('show'); startPinMode('destination'); }
$('#useLocationBtn').onclick=async()=>{
  if(pendingDestination){
    destinationPoint=pendingDestination.point;
    pendingDestination=null;
  }
  const ok=await prepareRealRoute(true);
  if(ok)toast('Ruta confirmada');
}

$('#cancelPin').onclick=()=>{stopPinMode();setSheetHeight(sheetLimits().mid,true)}
$('#confirmPin').onclick=async()=>{
  const center=map.getCenter();

  if(pinPurpose==='pickup'){
    currentStart=[center.lat,center.lng];
    gpsReady=true;
    localStorage.setItem('sobre_ruedas_test_location',JSON.stringify(currentStart));
    startMarker.setLatLng(currentStart).bindPopup('Ubicación temporal de prueba');
    $('#demoLocationText').textContent=`Punto personalizado · ${center.lat.toFixed(5)}, ${center.lng.toFixed(5)}`;
    $('#pickupText').textContent='Ubicación temporal seleccionada en el mapa';
    clearRoute();
    stopPinMode();
    map.setView(currentStart,16);
    toast('Ubicación temporal actualizada');
    setNotice('Punto de salida temporal guardado. El GPS real sigue desactivado.');
    setSheetHeight(sheetLimits().mid,true);
    return;
  }

  setDestinationPoint([center.lat,center.lng],$('#destination').value.trim()||'Destino marcado en el mapa');
  pendingDestination=null;
  $('#confirmLocation').classList.remove('show');
  stopPinMode();
  const ok=await prepareRealRoute(true);
  if(ok){toast('Destino marcado y ruta calculada');setSheetHeight(sheetLimits().mid,true)}
}
$('#destination').addEventListener('input',()=>{destinationPoint=null;clearRouteStatus()});

$('#refreshLocation').onclick=()=>{
  currentStart=[21.84206,-78.76000];
  gpsReady=true;
  localStorage.removeItem('sobre_ruedas_test_location');
  startMarker.setLatLng(currentStart).bindPopup('Ubicación de prueba: Parque José Martí, Ciego de Ávila');
  map.setView(currentStart,16);
