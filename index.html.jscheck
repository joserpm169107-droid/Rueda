}
$$('[data-dest]').forEach(b=>b.onclick=()=>{$('#destination').value=b.dataset.dest;destinationPoint=null;clearRouteStatus();showPage('home');toast('Destino seleccionado')})
$$('.vehicle').forEach(v=>v.onclick=()=>{$$('.vehicle').forEach(x=>x.classList.remove('active'));v.classList.add('active');selected={type:v.dataset.type,price:0,eta:+v.dataset.eta};updateFare()})
function renderPerKmLabels(){
  $$('.vehicle[data-type]').forEach(card=>{
    const rate=Number(fareRates[card.dataset.type]??DEFAULT_PER_KM[card.dataset.type]??0);
    card.dataset.price=String(rate);
    const holder=card.querySelector('.price')||card.querySelector('b');
    if(holder)holder.innerHTML='$'+rate+'<small>CUP/km</small>';
  });
}
async function loadFareSettings(){
  try{
    const {data,error}=await sb.from('fare_settings').select('vehicle_type,per_km,active');
    if(error)throw error;
    (data||[]).forEach(row=>{
      if(row.active!==false&&Number.isFinite(Number(row.per_km))&&Number(row.per_km)>=0){
        fareRates[row.vehicle_type]=Number(row.per_km);
      }
    });
    renderPerKmLabels();
    updateFare();
  }catch(error){
    console.warn('No se pudieron cargar las tarifas por km; se usarán valores de respaldo.',error?.message||error);
    renderPerKmLabels();
    updateFare();
  }
}
function listenFareSettings(){
  if(fareChannel)sb.removeChannel(fareChannel);
  fareChannel=sb.channel('public-fare-settings')
    .on('postgres_changes',{event:'*',schema:'public',table:'fare_settings'},()=>loadFareSettings())
    .subscribe();
}
function updateFare(){
  const km=Math.max(0,parseFloat($('#distance').textContent)||0);
  const rate=Number(fareRates[selected.type]??DEFAULT_PER_KM[selected.type]??0);
  const total=Math.max(0,Math.round(km*rate));
  selected.price=total;
  $('#perKmFare').textContent='$'+rate+' CUP/km';
  $('#distanceFare').textContent=km.toFixed(1)+' km × $'+rate;
  $('#discountRow').classList.add('hidden');
  $('#totalFare').textContent='$'+total+' CUP';
  $('#requestBtn').textContent=`Pedir ${selected.type} · $${total} CUP`;
}
$('#scheduleBtn').onclick=()=>$('#scheduleModal').classList.remove('hidden');$('#confirmSchedule').onclick=()=>{if(!$('#date').value||!$('#time').value)return toast('Selecciona fecha y hora');localStorage.setItem('rueda_schedule',JSON.stringify({date:$('#date').value,time:$('#time').value,destination:$('#destination').value}));$('#scheduleModal').classList.add('hidden');toast('Viaje programado')}
$$('[data-close]').forEach(b=>b.onclick=()=>$('#'+b.dataset.close).classList.add('hidden'))
$('#requestBtn').onclick=async()=>{
  const routeReady=await prepareRealRoute(false);
  if(!routeReady)return;
  const total=selected.price;
  const pickup=$('#pickupText').textContent.trim();
  const destination=$('#destination').value.trim();
  if(!destination)return toast('Selecciona un destino');
  $('#requestBtn').disabled=true;
  $('#requestBtn').textContent='Enviando solicitud...';
  const {data,error}=await sb.from('rides').insert({
    passenger_id:deviceId,
    passenger_name:user?.name||'Pasajero',
    pickup_address:pickup,
    destination_address:destination,
    vehicle_type:selected.type,
    price:total,
    payment_method:'efectivo',
    status:'searching',
    pickup_lat:Number(currentStart[0]),
    pickup_lng:Number(currentStart[1]),
    destination_lat:Array.isArray(destinationPoint)?Number(destinationPoint[0]):null,
    destination_lng:Array.isArray(destinationPoint)?Number(destinationPoint[1]):null,
    distance_km:Math.max(0,parseFloat($('#distance').textContent)||0)
  }).select().single();
  $('#requestBtn').disabled=false;
  updateFare();
  if(error)return backendError(error,'No se pudo solicitar el viaje');
  currentRideId=data.id;
  activeRidePrice=Number(data.price||total||0);
  listenPassengerRide(currentRideId);
  setSheetHeight(sheetLimits().min,true);
  $('#homePanel').classList.add('hidden');
  $('#tripPanel').classList.remove('hidden');
  $('#tripStatus').textContent='Buscando conductor';
  $('#eta').textContent='Buscando';
  $('#tripPrice').textContent='$'+total;
  $('#progress').style.width='8%';
  updateTripStage(1);
  toast('Solicitud enviada a los conductores');
}
