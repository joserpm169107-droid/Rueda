function toast(msg){const t=$('#toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2200)}

function setNotice(msg){$('#lastNotice').textContent=msg;localStorage.setItem('rueda_last_notice',msg)}
function makeTripCode(){return String(Math.floor(1000+Math.random()*9000))}
function updateTripStage(stage){
  tripPhase=stage;
  [1,2,3,4].forEach(i=>{
    const el=$('#stage'+i);
    el.classList.toggle('done',i<stage);
    el.classList.toggle('active',i===stage);
  });
}

function backendError(error, fallback='No se pudo conectar con el servidor'){
  console.error(error);
  const msg=error?.message||fallback;
  if(msg.includes('row-level security')||msg.includes('permission denied')){
    toast('Faltan los permisos de Supabase');
  }else{
    toast(fallback);
  }
}
async function fetchCurrentProfile(){
  const {data,error}=await sb.from('profiles').select('*').eq('device_id',deviceId).maybeSingle();
  if(error){console.warn('No se pudo leer el perfil:',error.message);return null}
  currentProfile=data||null;
  if(currentProfile&&user){
    user.name=currentProfile.full_name||user.name;
    user.email=currentProfile.email||user.email;
    user.phone=currentProfile.phone||user.phone;
    user.role=currentProfile.role||user.role;
    user.approved=currentProfile.approval_status==='approved'&&currentProfile.status==='active';
    user.verificationStatus=currentProfile.approval_status||user.verificationStatus;
    user.vehicle=currentProfile.vehicle_type||user.vehicle;
    localStorage.setItem(AUTH,JSON.stringify(user));
  }
  return currentProfile;
}
async function saveProfileForUser(sessionUser,approvalOverride){
  const {data:existing,error:readError}=await sb.from('profiles').select('*').eq('device_id',deviceId).maybeSingle();
  if(readError){backendError(readError,'No se pudo comprobar el perfil');return null}
  if(existing?.status==='deleted'||existing?.approval_status==='deleted'){
    currentProfile=existing;toast('Esta cuenta fue eliminada por administración');return null;
  }

  const now=new Date().toISOString();
  const driver=sessionUser.role==='driver';
  if(existing){
    // Conserva la aprobación y el bloqueo administrados desde el panel.
    const changes={role:sessionUser.role,full_name:sessionUser.name||existing.full_name||null,phone:sessionUser.phone||existing.phone||null,email:sessionUser.email||existing.email||null,vehicle_type:sessionUser.vehicle||existing.vehicle_type||null,updated_at:now};
    const {data,error}=await sb.from('profiles').update(changes).eq('id',existing.id).select().single();
    if(error){backendError(error,'No se pudo actualizar el perfil');return null}
    currentProfile=data;return data;
  }

  const approval=approvalOverride||(driver?'pending':'approved');
  const payload={device_id:deviceId,role:sessionUser.role,full_name:sessionUser.name||null,phone:sessionUser.phone||null,email:sessionUser.email||null,status:'active',vehicle_type:sessionUser.vehicle||null,approval_status:approval,is_online:false,last_seen_at:now,updated_at:now};
  let {data,error}=await sb.from('profiles').insert(payload).select().single();
  if(error&&error.code==='23505'){
    const retry=await sb.from('profiles').select('*').eq('device_id',deviceId).maybeSingle();
    data=retry.data;error=retry.error;
  }
  if(error||!data){backendError(error||{message:'Respuesta vacía de Supabase'},'No se pudo guardar el perfil');return null}
  currentProfile=data;return data;
}
async function driverCanOperate(showMessage=true){
  if(user?.role!=='driver')return false;
  const profile=await fetchCurrentProfile()||await saveProfileForUser(user,'pending');
  if(!profile)return false;
  if(profile.status==='deleted'){
    if(showMessage)toast('Esta cuenta de conductor fue eliminada por administración');
    return false;
  }
  if(profile.status==='blocked'||profile.approval_status==='rejected'){
    if(showMessage)toast('Cuenta de conductor desaprobada. Contacta a administración');
    return false;
  }
  if(profile.approval_status!=='approved'){
    if(showMessage)toast('Tu cuenta de conductor está pendiente de aprobación');
    return false;
  }
  return true;
}
async function setDriverPresence(online,coords=null){
  if(user?.role!=='driver')return;
  const profile=currentProfile||await fetchCurrentProfile();if(!profile)return;
  const now=new Date().toISOString();
  const payload={is_online:Boolean(online),last_seen_at:now,updated_at:now};
  if(coords&&Number.isFinite(Number(coords[0]))&&Number.isFinite(Number(coords[1]))){payload.last_lat=Number(coords[0]);payload.last_lng=Number(coords[1])}
  const {error}=await sb.from('profiles').update(payload).eq('id',profile.id);
  if(!error)currentProfile={...profile,...payload};
  if(!error&&currentRideId&&online&&payload.last_lat!=null){await sb.from('rides').update({driver_lat:payload.last_lat,driver_lng:payload.last_lng,updated_at:now}).eq('id',currentRideId).in('status',['accepted','arrived','in_progress'])}
}
function stopPresenceHeartbeat(){if(presenceTimer){clearInterval(presenceTimer);presenceTimer=null}}
function startPresenceHeartbeat(){stopPresenceHeartbeat();presenceTimer=setInterval(()=>{if(driverOnline)setDriverPresence(true,currentStart)},15000)}
async function syncProfileUi(){
  const profile=await fetchCurrentProfile();if(!profile||!user)return;
  if(profile.status==='deleted'){
    stopPassengerChannel();stopDriverChannel();stopProfileChannel();localStorage.removeItem(AUTH);user=null;
    $('#auth').classList.remove('hidden');toast('Esta cuenta fue eliminada por administración');return;
  }
  const driver=user.role==='driver';
  const approved=driver&&profile.approval_status==='approved'&&profile.status==='active';
  $('#switchPassenger').classList.toggle('active',!driver);$('#switchDriver').classList.toggle('active',driver);
  if(driver){$$('[data-mode]').forEach(x=>x.classList.toggle('active',x.dataset.mode==='driver'));$('#homePanel').classList.add('hidden');$('#driverPanel').classList.remove('hidden')}
  $('#drawerRole').textContent=driver?(approved?'Conductor aprobado':profile.approval_status==='rejected'?'Conductor desaprobado':'Conductor pendiente de aprobación'):'Usuario verificado';
  $('#roleStatus').textContent=driver?(approved?'Cuenta de conductor activa.':profile.approval_status==='rejected'?'La administración desaprobó o bloqueó esta cuenta.':'Identificación pendiente de revisión administrativa.'):'Cuenta de usuario activa.';
  $('#identityBadge').textContent=driver?(approved?'Aprobada':profile.approval_status==='rejected'?'Desaprobada':'Pendiente'):'Verificada';
  if(driver&&!approved){driverOnline=false;$('#onlineToggle').classList.remove('on');$('#onlineText').textContent=profile.approval_status==='rejected'?'Bloqueado':'Pendiente';stopDriverChannel();}
}

function stopPassengerChannel(){
  if(passengerChannel){sb.removeChannel(passengerChannel);passengerChannel=null}
}
function stopDriverChannel(){
  if(driverChannel){sb.removeChannel(driverChannel);driverChannel=null}
}
function stopProfileChannel(){
  if(profileChannel){sb.removeChannel(profileChannel);profileChannel=null}
}
function listenProfileUpdates(){
  stopProfileChannel();
  profileChannel=sb.channel('profile-'+deviceId)
    .on('postgres_changes',{event:'UPDATE',schema:'public',table:'profiles',filter:'device_id=eq.'+deviceId},payload=>{
      currentProfile=payload.new||null;
      syncProfileUi();
    })
    .on('postgres_changes',{event:'DELETE',schema:'public',table:'profiles'},payload=>{
      if(String(payload.old?.device_id||'')===String(deviceId)){currentProfile=null;syncProfileUi()}
    })
    .subscribe();
}
function rideStatusText(status){
  return {
    searching:'Buscando conductor',
    accepted:'Conductor en camino',
    arrived:'El conductor llegó',
    in_progress:'Viaje en curso',
    finished:'Viaje finalizado',
    canceled:'Viaje cancelado'
  }[status]||'Actualizando viaje';
}
function applyPassengerRide(ride){
  if(!ride||ride.id!==currentRideId)return;
  $('#tripStatus').textContent=rideStatusText(ride.status);
  if(ride.status==='searching'){
    $('#eta').textContent='Buscando';
    updateTripStage(1);
  }
  if(ride.status==='accepted'){
    $('#eta').textContent='3 min';
    updateTripStage(1);
    const card=$('#tripPanel .driver-card');
    if(card){
      const strong=card.querySelector('strong');
      const small=card.querySelector('small');
      if(strong)strong.textContent=ride.driver_name||'Conductor asignado';
      if(small)small.textContent=(ride.vehicle_type||'Vehículo')+' · pago en efectivo';
    }
    toast('Un conductor aceptó tu viaje');
  }
  if(ride.status==='arrived'){
    $('#eta').textContent='Esperando';
    updateTripStage(2);
    toast('Tu conductor llegó');
  }
  if(ride.status==='in_progress'){
    $('#eta').textContent='En ruta';
    updateTripStage(3);
    toast('Viaje iniciado');
  }
  if(ride.status==='finished'){
    $('#eta').textContent='Completado';
    updateTripStage(4);
    toast('Viaje finalizado');
  }
  if(ride.status==='canceled'){
    toast('El viaje fue cancelado');
    stopPassengerChannel();
    currentRideId=null;
    $('#tripPanel').classList.add('hidden');
    $('#homePanel').classList.remove('hidden');
  }
}
function listenPassengerRide(rideId){
  stopPassengerChannel();
  passengerChannel=sb.channel('passenger-'+rideId)
    .on('postgres_changes',{event:'UPDATE',schema:'public',table:'rides',filter:'id=eq.'+rideId},payload=>applyPassengerRide(payload.new))
    .subscribe();
}
function showIncomingRide(ride){
  if(!driverOnline||!ride||ride.status!=='searching')return;
  incomingRide=ride;
  $('#incomingRideMeta').textContent=(ride.vehicle_type||'Motorina')+' · '+(ride.payment_method||'efectivo');
  $('#incomingRidePrice').textContent='$'+Number(ride.price||180)+' CUP';
  $('#incomingPickup').textContent='● '+ride.pickup_address;
  $('#incomingDestination').textContent='◆ '+ride.destination_address;
  $('#driverSummary').classList.add('hidden');
  $('#driverRequest').classList.remove('hidden');
  let c=30;
  $('#count').textContent=c;
  clearInterval(driverTimer);
  driverTimer=setInterval(()=>{
    c--;
    $('#count').textContent=c;
    if(c<=0){
      clearInterval(driverTimer);
      $('#driverRequest').classList.add('hidden');
      $('#driverSummary').classList.remove('hidden');
      incomingRide=null;
    }
  },1000);
  toast('Nueva solicitud de viaje');
}
async function findWaitingRide(){
  const {data,error}=await sb.from('rides').select('*').eq('status','searching').order('created_at',{ascending:true}).limit(1);
  if(error)return backendError(error,'No se pudieron buscar viajes');
  if(data?.[0])showIncomingRide(data[0]);
}
function listenDriverRequests(){
  stopDriverChannel();
  driverChannel=sb.channel('drivers-searching')
    .on('postgres_changes',{event:'INSERT',schema:'public',table:'rides'},payload=>showIncomingRide(payload.new))
    .on('postgres_changes',{event:'UPDATE',schema:'public',table:'rides'},payload=>{
      if(incomingRide?.id===payload.new.id&&payload.new.status!=='searching'){
        $('#driverRequest').classList.add('hidden');
        incomingRide=null;
      }
    })
    .subscribe();
  findWaitingRide();
}
async function updateRideStatus(status, extra={}){
  if(!currentRideId)return;
  const {data,error}=await sb.from('rides').update({status,...extra}).eq('id',currentRideId).select().single();
  if(error){backendError(error,'No se pudo actualizar el viaje');throw error}
  return data;
}

async function saveSession(u){
  user=u;
  let profile=await fetchCurrentProfile();
  if(!profile)profile=await saveProfileForUser(u,u.role==='driver'?'pending':'approved');
  if(profile){
    user={...u,name:profile.full_name||u.name,email:profile.email||u.email,phone:profile.phone||u.phone,role:profile.role||u.role,vehicle:profile.vehicle_type||u.vehicle,approved:profile.approval_status==='approved'&&profile.status==='active',verificationStatus:profile.approval_status||u.verificationStatus};
  }
  localStorage.setItem(AUTH,JSON.stringify(user));
  openApp();
}
function openApp(){
  user=user||JSON.parse(localStorage.getItem(AUTH)||'null');
  if(!user)return;
  $('#auth').classList.add('hidden');
  const name=user.name||'Usuario Rueda';
  const role=user.role||'passenger';
  $('#helloName').textContent=name.split(' ')[0];
  $('#accountName').textContent=name;
  $('#drawerName').textContent=name;
  $('#accountEmail').textContent=user.email||user.phone||'Cuenta verificada';
  $('#lastNotice').textContent=localStorage.getItem('rueda_last_notice')||'No tienes alertas nuevas.';
  $('#accountRole').textContent=role==='driver'?'🛵 Conductor':'🙋 Usuario';
  $('#accountAvatar').textContent=role==='driver'?'🛵':'👤';
  $('#drawerRole').textContent=role==='driver'?'Conductor '+(user.approved?'aprobado':'activa en modo desarrollo'):'Usuario verificado';
  $('#roleStatus').textContent=role==='driver'?(user.approved?'Cuenta de conductor activa.':'Identificación pendiente de revisión.'):'Cuenta de usuario activa.';
  $('#identityBadge').textContent=role==='driver'?(user.approved?'Aprobada':'Pendiente'):'Verificada';
  $('#switchPassenger').classList.toggle('active',role==='passenger');
  $('#switchDriver').classList.toggle('active',role==='driver');
  $$('[data-mode]').forEach(b=>b.style.display=(role==='passenger'&&b.dataset.mode==='driver')?'none':'');
  if(role==='driver'){$$('[data-mode]').forEach(x=>x.classList.toggle('active',x.dataset.mode==='driver'));$('#homePanel').classList.add('hidden');$('#driverPanel').classList.remove('hidden');}
  syncProfileUi();listenProfileUpdates();
}
function logout(){if(!confirm('¿Deseas cerrar sesión en Sobre Ruedas?'))return;stopPresenceHeartbeat();if(user?.role==='driver')setDriverPresence(false);stopPassengerChannel();stopDriverChannel();stopProfileChannel();localStorage.removeItem(AUTH);sessionStorage.clear();user=null;$('#auth').classList.remove('hidden');$('#drawer').classList.remove('open');$('#backdrop').classList.add('hidden');$('#loginEmail').value='';$('#loginPass').value='';toast('Sesión cerrada correctamente')}
$$('[data-auth]').forEach(b=>b.onclick=()=>{$$('[data-auth]').forEach(x=>x.classList.remove('active'));b.classList.add('active');const login=b.dataset.auth==='login';$('#loginForm').classList.toggle('hidden',!login);$('#registerForm').classList.toggle('hidden',login)})
$$('[data-register-role]').forEach(b=>b.onclick=()=>{
  registerRole=b.dataset.registerRole;
  $$('[data-register-role]').forEach(x=>x.classList.toggle('active',x===b));
  const driver=registerRole==='driver';
  $('#driverFields').classList.toggle('hidden',!driver);
  $('#registerBtn').textContent=driver?'Crear cuenta de conductor':'Crear cuenta de usuario';
})
$('#driverDocument').onchange=()=>{
  const file=$('#driverDocument').files[0];
  if(!file){
    $('#documentPreview').classList.add('hidden');
    $('#documentName').textContent='Ninguna foto seleccionada';
    return;
  }
  $('#documentName').textContent=file.name;
  const reader=new FileReader();
  reader.onload=e=>{
    $('#documentPreview').src=e.target.result;
    $('#documentPreview').classList.remove('hidden');
  };
  reader.readAsDataURL(file);
}
$('#loginBtn').onclick=async()=>{const email=$('#loginEmail').value.trim(),pass=$('#loginPass').value;if(!email||!pass)return toast('Completa correo y contraseña');await saveSession({name:email.split('@')[0],email,role:'passenger'})}
$('#registerBtn').onclick=async()=>{
  const name=$('#regName').value.trim();
  const email=$('#regEmail').value.trim();
  const phone=$('#regPhone').value.trim();
  const pass=$('#regPass').value;
  if(!name||!email||!phone||pass.length<4)return toast('Completa los datos correctamente');
  const data={name,email,phone,role:registerRole,approved:registerRole!=='driver'};
  if(registerRole==='driver'){
    const vehicle=$('#driverVehicle').value;
    const documentFile=$('#driverDocument').files[0];
    const accepted=$('#driverTerms').checked;
    if(!vehicle)return toast('Selecciona el tipo de vehículo');
    if(!documentFile)return toast('Sube una foto de tu identificación');
    if(!accepted)return toast('Acepta la revisión de la identificación');
    Object.assign(data,{vehicle,documentName:documentFile.name,approved:false,verificationStatus:'pending'});
    setNotice('Tu identificación fue enviada. La solicitud está pendiente de revisión.');
  }
  $('#registerBtn').disabled=true;
  const profile=await saveProfileForUser(data,registerRole==='driver'?'pending':'approved');
  $('#registerBtn').disabled=false;
  if(!profile)return;
  saveSession(data);
  toast(registerRole==='driver'?'Cuenta creada. Espera la aprobación del administrador':'Cuenta creada correctamente');
}
$('#phoneBtn').onclick=async()=>saveSession({name:'Usuario Rueda',phone:'+53 5XX XXX XX',role:'passenger'});$('#googleBtn').onclick=async()=>saveSession({name:'José Ramón',email:'jose@rueda.demo',role:'passenger'});$('#logoutBtn').onclick=logout;
$('#switchPassenger').onclick=()=>{
  if(!user)return;
  user.role='passenger';
  localStorage.setItem(AUTH,JSON.stringify(user));
  openApp();showPage('home');toast('Cambiaste a modo usuario');
}
$('#switchDriver').onclick=()=>{
  if(!user)return;
  if(user.role==='driver'){toast(user.approved?'Modo conductor activo':'Tu cuenta de conductor está activa en modo desarrollo');return}
  const go=confirm('Para ser conductor debes completar el registro y enviar tus documentos. ¿Deseas cerrar sesión y registrarte como conductor?');
  if(go){logout();setTimeout(()=>{document.querySelector('[data-auth="register"]').click();document.querySelector('[data-register-role="driver"]').click()},200)}
}
$('#roleInfoBtn').onclick=()=>toast('Usuario solicita viajes. Conductor recibe solicitudes y necesita aprobación.')



// Panel inferior deslizable: arriba para ver opciones, abajo para agrandar el mapa
const mainSheet=$('#mainSheet');
const sheetHandle=$('#sheetHandle');
let sheetStartY=0;
let sheetStartHeight=0;
let sheetDragging=false;

function sheetLimits(){
  const viewport=document.querySelector('.app').clientHeight;
  return {
    min:Math.max(135,viewport*.20),
    mid:viewport*.56,
    max:viewport*.92
  };
}
function setSheetHeight(px,animate=true){
  const limits=sheetLimits();
  const height=Math.max(limits.min,Math.min(limits.max,px));
  mainSheet.classList.toggle('dragging',!animate);
  mainSheet.style.height=height+'px';
  setTimeout(()=>map.invalidateSize(),animate?290:0);
}
function snapSheet(){
  const limits=sheetLimits();
  const current=mainSheet.getBoundingClientRect().height;
  const points=[limits.min,limits.mid,limits.max];
  const target=points.reduce((a,b)=>Math.abs(b-current)<Math.abs(a-current)?b:a);
  mainSheet.classList.remove('dragging');
  setSheetHeight(target,true);
}
function startSheetDrag(clientY){
  sheetDragging=true;
  sheetStartY=clientY;
  sheetStartHeight=mainSheet.getBoundingClientRect().height;
  mainSheet.classList.add('dragging');
}
function moveSheetDrag(clientY){
  if(!sheetDragging)return;
  const delta=sheetStartY-clientY;
  setSheetHeight(sheetStartHeight+delta,false);
}
function endSheetDrag(){
  if(!sheetDragging)return;
  sheetDragging=false;
  snapSheet();
}
sheetHandle.addEventListener('pointerdown',e=>{
  sheetHandle.setPointerCapture?.(e.pointerId);
  startSheetDrag(e.clientY);
});
sheetHandle.addEventListener('pointermove',e=>moveSheetDrag(e.clientY));
sheetHandle.addEventListener('pointerup',endSheetDrag);
sheetHandle.addEventListener('pointercancel',endSheetDrag);
sheetHandle.addEventListener('dblclick',()=>{
  const limits=sheetLimits();
  const current=mainSheet.getBoundingClientRect().height;
  setSheetHeight(current>limits.mid?limits.min:limits.max,true);
});
window.addEventListener('resize',()=>setSheetHeight(sheetLimits().mid,false));

const map=L.map('map',{zoomControl:false}).setView([21.84206,-78.76000],15);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap'}).addTo(map);
let startMarker=L.marker(currentStart).addTo(map).bindPopup('Ubicación de prueba: Parque José Martí, Ciego de Ávila');

try{
  const savedTestLocation=JSON.parse(localStorage.getItem('sobre_ruedas_test_location')||'null');
  if(Array.isArray(savedTestLocation) && savedTestLocation.length===2 &&
     Number.isFinite(+savedTestLocation[0]) && Number.isFinite(+savedTestLocation[1]) &&
     insideCiego([+savedTestLocation[0],+savedTestLocation[1]])){
    currentStart=[+savedTestLocation[0],+savedTestLocation[1]];
    startMarker.setLatLng(currentStart).bindPopup('Ubicación temporal de prueba');
    map.setView(currentStart,16);
    $('#demoLocationText').textContent=`Punto personalizado · ${currentStart[0].toFixed(5)}, ${currentStart[1].toFixed(5)}`;
    $('#pickupText').textContent='Ubicación temporal seleccionada en el mapa';
  }
}catch(e){
  localStorage.removeItem('sobre_ruedas_test_location');
}


function setRouteStatus(title,text,type='loading'){
  const box=$('#routeStatus');
  box.classList.add('show');
  box.classList.toggle('ok',type==='ok');
  box.classList.toggle('warn',type==='warn');
  $('#routeStatusTitle').textContent=title;
  $('#routeStatusText').textContent=text;
}
function clearRouteStatus(){ $('#routeStatus').classList.remove('show','ok','warn'); }

function normalizeStreet(s){
  return (s||'')
    .replace(/\b(calle|avenida|ave\.?|calzada|carretera)\b/gi,'')
    .replace(/\s+/g,' ')
    .trim();
}
function parseCubanAddress(text){
  const raw=(text||'').trim();
  const m=raw.match(/^(.*?)\s+entre\s+(.*?)\s+(?:y|e)\s+(.*?)(?:,\s*(.*))?$/i);
  if(!m)return {type:'normal',raw};
  return {
    type:'block',
    raw,
    main:normalizeStreet(m[1]),
    cross1:normalizeStreet(m[2]),
    cross2:normalizeStreet(m[3]),
    extra:(m[4]||'').trim()
  };
}
function haversineKm(a,b){
  const R=6371;
  const toRad=x=>x*Math.PI/180;
  const dLat=toRad(b[0]-a[0]), dLon=toRad(b[1]-a[1]);
  const s=Math.sin(dLat/2)**2+Math.cos(toRad(a[0]))*Math.cos(toRad(b[0]))*Math.sin(dLon/2)**2;
  return 2*R*Math.asin(Math.sqrt(s));
}
function insideCiego(point){
  return point && point[0]>=21.72 && point[0]<=21.95 && point[1]>=-78.90 && point[1]<=-78.60;
}
function escapeOverpass(s){
  return (s||'').replace(/\\/g,'\\\\').replace(/"/g,'\\"').replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
}
async function fetchJSON(url,options={},timeout=14000){
  const controller=new AbortController();
  const timer=setTimeout(()=>controller.abort(),timeout);
  try{
    const res=await fetch(url,{...options,signal:controller.signal});
    if(!res.ok)throw new Error('HTTP '+res.status);
    return await res.json();
  }finally{clearTimeout(timer)}
}
async function nominatimSearch(query){
  const params=new URLSearchParams({
    q:query,
    format:'jsonv2',
    limit:'6',
    countrycodes:'cu',
    addressdetails:'1',
    'accept-language':'es',
    viewbox:'-78.90,21.95,-78.60,21.70',
    bounded:'1'
  });
  return fetchJSON('https://nominatim.openstreetmap.org/search?'+params.toString(),{
    headers:{'Accept':'application/json'}
  });
}
async function overpassIntersection(main,cross){
  const a=escapeOverpass(main), b=escapeOverpass(cross);
  const q=`[out:json][timeout:20];
    area["boundary"="administrative"]["name"~"Ciego de Ávila",i]->.searchArea;
    way(area.searchArea)["highway"]["name"~"${a}",i]->.a;
    way(area.searchArea)["highway"]["name"~"${b}",i]->.b;
    node(w.a)(w.b);
    out body;`;
  const endpoints=[
    'https://overpass-api.de/api/interpreter',
    'https://overpass.kumi.systems/api/interpreter'
  ];
  let lastErr;
  for(const endpoint of endpoints){
    try{
      const data=await fetchJSON(endpoint,{
        method:'POST',
        headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},
        body:'data='+encodeURIComponent(q)
      },22000);
      if(data.elements?.length){
        const p=data.elements[0];
        return [p.lat,p.lon];
      }
    }catch(e){lastErr=e}
  }
  if(lastErr)throw lastErr;
  return null;
}
async function geocodeCubanAddress(text){
  const parsed=parseCubanAddress(text);
  if(parsed.type==='block'){
    setRouteStatus('Buscando la cuadra','Localizando las dos esquinas de '+parsed.main+'.');
    try{
      const [p1,p2]=await Promise.all([
        overpassIntersection(parsed.main,parsed.cross1),
        overpassIntersection(parsed.main,parsed.cross2)
      ]);
      if(p1&&p2){
        const separation=haversineKm(p1,p2);
        if(insideCiego(p1)&&insideCiego(p2)&&separation<=1.2){
          return {
            point:[(p1[0]+p2[0])/2,(p1[1]+p2[1])/2],
            label:`${parsed.main} entre ${parsed.cross1} y ${parsed.cross2}`,
            source:'intersections',
            confidence:'high'
          };
        }
      }
      // No usamos una sola esquina automáticamente porque puede ser otra calle con el mismo nombre.
      return null;
    }catch(e){}
  }

  const city='Ciego de Ávila, Cuba';
  const attempts=[
    `${text}, ${city}`,
    parsed.type==='block'?`${parsed.main}, ${city}`:'',
    parsed.type==='block'?`${parsed.cross1}, ${city}`:'',
    text
  ].filter(Boolean);

  for(const q of attempts){
    try{
      const results=await nominatimSearch(q);
      if(results?.length){
        const valid=results
          .map(r=>({...r,point:[+r.lat,+r.lon]}))
          .filter(r=>insideCiego(r.point));
        if(valid.length){
          const best=valid[0];
          return {
            point:best.point,
            label:best.display_name||text,
            source:'geocoder',
            confidence:'medium'
          };
        }
      }
    }catch(e){}
  }
  return null;
}
function decodePolyline6(str){
  let index=0,lat=0,lng=0,coordinates=[];
  while(index<str.length){
    let b,shift=0,result=0;
    do{b=str.charCodeAt(index++)-63;result|=(b&0x1f)<<shift;shift+=5}while(b>=0x20);
    const dlat=(result&1)?~(result>>1):(result>>1);lat+=dlat;
    shift=0;result=0;
    do{b=str.charCodeAt(index++)-63;result|=(b&0x1f)<<shift;shift+=5}while(b>=0x20);
    const dlng=(result&1)?~(result>>1):(result>>1);lng+=dlng;
    coordinates.push([lat/1e6,lng/1e6]);
  }
  return coordinates;
}
function routeCosting(){
  if(selected.type==='Bicitaxi')return {
    costing:'bicycle',
    costing_options:{bicycle:{bicycle_type:'hybrid',cycling_speed:12,use_roads:.35,use_hills:.4}}
  };
  if(selected.type==='Motorina')return {
    costing:'motor_scooter',
    costing_options:{motor_scooter:{top_speed:45,use_primary:.45,use_hills:.5}}
  };
  if(selected.type==='Moto')return {
    costing:'motorcycle',
    costing_options:{motorcycle:{use_highways:.1,use_tolls:0,use_trails:.1}}
  };
  return {
    costing:'motor_scooter',
    costing_options:{motor_scooter:{top_speed:35,use_primary:.3,use_hills:.4}}
  };
}
async function getStreetRoute(from,to){
  const mode=routeCosting();
  const payload={
    locations:[
      {lat:from[0],lon:from[1],type:'break'},
      {lat:to[0],lon:to[1],type:'break'}
    ],
    costing:mode.costing,
    costing_options:mode.costing_options,
    units:'kilometers',
    language:'es-ES',
    directions_options:{units:'kilometers'}
  };
  try{
    const data=await fetchJSON('https://valhalla.openstreetmap.de/route',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify(payload)
    },22000);
    const shape=data.trip?.legs?.[0]?.shape;
    if(!shape)throw new Error('Sin geometría');
    return {
      points:decodePolyline6(shape),
      distance:data.trip.summary.length,
      minutes:Math.max(1,Math.round(data.trip.summary.time/60)),
      source:'Valhalla/OSM'
    };
  }catch(e){
    const profile='driving';
    const url=`https://router.project-osrm.org/route/v1/${profile}/${from[1]},${from[0]};${to[1]},${to[0]}?overview=full&geometries=geojson&steps=false`;
    const data=await fetchJSON(url,{},18000);
    const coords=data.routes?.[0]?.geometry?.coordinates;
    if(!coords)throw e;
    return {
      points:coords.map(c=>[c[1],c[0]]),
      distance:data.routes[0].distance/1000,
      minutes:Math.max(1,Math.round(data.routes[0].duration/60)),
      source:'OSRM/OSM'
    };
  }
}
function setDestinationPoint(point,label){
  destinationPoint=point;
  if(destinationMarker)map.removeLayer(destinationMarker);
  destinationMarker=L.marker(point).addTo(map).bindPopup(label||'Destino');
  $('#destination').value=label||$('#destination').value;
}
async function prepareRealRoute(forceConfirmed=false){
  const requestId=++routeRequestId;
  const text=$('#destination').value.trim();
  if(!text){toast('Escribe o marca un destino');return false}

  if(!gpsReady){
    setRouteStatus('Falta confirmar tu salida','Pulsa actualizar ubicación para usar tu GPS real.','warn');
    toast('Actualiza primero tu ubicación');
    return false;
  }

  if(!destinationPoint){
    setRouteStatus('Buscando dirección','Interpretando el formato de dirección usado en Cuba.');
    const result=await geocodeCubanAddress(text);
    if(requestId!==routeRequestId)return false;
    if(!result){
      setRouteStatus('Dirección dudosa','No encontré las dos esquinas con suficiente seguridad. Márcala en el mapa.','warn');
      setSheetHeight(sheetLimits().min,true);
      startPinMode();
      return false;
    }
    pendingDestination=result;
    setDestinationPoint(result.point,text);
    map.setView(result.point,17);
    $('#confirmLocationText').textContent='Punto encontrado para: '+text+'. Revisa que el pin esté realmente dentro de la cuadra.';
    $('#confirmLocation').classList.add('show');
    setRouteStatus('Punto encontrado','Confirma el pin antes de trazar la ruta.','warn');
    if(!forceConfirmed)return false;
  }

  $('#confirmLocation').classList.remove('show');
  setRouteStatus('Calculando ruta por calles',`Buscando vías permitidas para ${selected.type}.`);
  try{
    const route=await getStreetRoute(currentStart,destinationPoint);
    if(requestId!==routeRequestId)return false;
    if(routeLine)map.removeLayer(routeLine);
    routeLine=L.polyline(route.points,{color:'#1677ff',weight:6,opacity:.9,lineJoin:'round'}).addTo(map);
    map.fitBounds(routeLine.getBounds(),{padding:[60,60]});
    $('#distance').textContent=route.distance.toFixed(1)+' km';updateFare();
    $('#eta').textContent=route.minutes+' min';
    setRouteStatus('Ruta encontrada',`${route.distance.toFixed(1)} km · ${route.minutes} min · ${selected.type}.`,'ok');
    return true;
  }catch(e){
    setRouteStatus('No pude calcular la ruta','Revisa el punto o inténtalo de nuevo.','warn');
    return false;
  }
}
function startPinMode(purpose='destination'){
  pinPurpose=purpose;
  pinPicking=true;
  setSheetHeight(sheetLimits().min,true);
  $('#pinMode').classList.remove('hidden');
  $('#mapConfirm').classList.remove('hidden');
  if(purpose==='pickup'){
    $('#pinModeText').textContent='Mueve el mapa hasta tu ubicación temporal de prueba';
    $('#confirmPin').textContent='Usar como salida';
    map.setView(currentStart,16);
  }else{
    $('#pinModeText').textContent='Mueve el mapa hasta el destino';
    $('#confirmPin').textContent='Confirmar destino';
  }
  map.invalidateSize();
}
function stopPinMode(){
  pinPicking=false, pendingDestination=null, gpsReady=true;
  $('#pinMode').classList.add('hidden');
  $('#mapConfirm').classList.add('hidden');
}

$('#locateBtn').onclick=()=>{map.setView(currentStart,16);toast('Ubicación centrada')}
$('#changeDemoLocation').onclick=()=>startPinMode('pickup');
$('#resetDemoLocation').onclick=()=>{
  currentStart=[21.84206,-78.76000];
