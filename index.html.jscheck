$('#shareBtn').onclick=()=>{const text='Estoy viajando con Rueda hacia '+$('#destination').value+'. Conductor Daniel R., placa CA-218.';if(navigator.share)navigator.share({title:'Mi viaje en Rueda',text});else navigator.clipboard?.writeText(text);toast('Viaje compartido')}
$('#emergencyBtn').onclick=()=>toast('Función de emergencia preparada para configuración local')
function showPage(page){setSheetHeight(sheetLimits().mid,true);['home','history','saved','account'].forEach(p=>$('#'+p+'Panel').classList.toggle('hidden',p!==page));$('#tripPanel').classList.add('hidden');$('#driverPanel').classList.add('hidden');$$('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===page))}
$$('.nav button').forEach(b=>b.onclick=()=>showPage(b.dataset.page));$('#profileBtn').onclick=()=>showPage('account')
function openDrawer(){$('#drawer').classList.add('open');$('#backdrop').classList.remove('hidden')}function closeDrawer(){$('#drawer').classList.remove('open');$('#backdrop').classList.add('hidden')}$('#menuBtn').onclick=openDrawer;$('#closeDrawer').onclick=closeDrawer;$('#backdrop').onclick=closeDrawer;$$('[data-drawer-page]').forEach(b=>b.onclick=()=>{showPage(b.dataset.drawerPage);closeDrawer()})
