let user=null, currentProfile=null, registerRole='passenger', selected={type:'Motorina',price:0,eta:3}, tripTimer=null, driverTimer=null, routeLine=null, driverMarker=null, tripPhase=0, gpsWatch=null, destinationMarker=null, destinationPoint=null, currentStart=[21.84206,-78.76000], pinPicking=false, pinPurpose='destination', pendingDestination=null, gpsReady=true, driverTripState='idle', driverTripStartedAt=null, currentRideId=null, incomingRide=null, passengerChannel=null, driverChannel=null, profileChannel=null, driverOnline=false, activeRidePrice=0, ratingShownRideId=null, ratingSubmitting=false, lastProfileGpsUpdate=0, presenceTimer=null;
