$$('[data-mode]').forEach(b=>b.onclick=()=>{$$('[data-mode]').forEach(x=>x.classList.remove('active'));b.classList.add('active');const driver=b.dataset.mode==='driver';$('#homePanel').classList.toggle('hidden',driver);$('#tripPanel').classList.add('hidden');$('#historyPanel').classList.add('hidden');$('#savedPanel').classList.add('hidden');$('#accountPanel').classList.add('hidden');$('#driverPanel').classList.toggle('hidden',!driver)})
$('#onlineToggle').onclick=async()=>{
  const wantsOnline=!$('#onlineToggle').classList.contains('on');
  if(wantsOnline&&!(await driverCanOperate(true))){$('#onlineToggle').classList.remove('on');$('#onlineText').textContent=currentProfile?.approval_status==='rejected'?'Bloqueado':'Pendiente';return}
  driverOnline=$('#onlineToggle').classList.toggle('on');
  $('#onlineText').textContent=driverOnline?'Disponible':'Desconectado';
  $('#driverSummary').classList.toggle('hidden',driverOnline);
  await setDriverPresence(driverOnline,currentStart);
  if(driverOnline){
    startDriverGpsWatch(false);startPresenceHeartbeat();listenDriverRequests();
    toast('Conductor disponible y visible en el mapa en vivo');
  }else{
    stopPresenceHeartbeat();stopDriverChannel();clearInterval(driverTimer);incomingRide=null;
    $('#driverRequest').classList.add('hidden');$('#driverActiveTrip').classList.add('hidden');$('#driverSummary').classList.remove('hidden');
    toast('Conductor desconectado');
  }
}
$('#declineBtn').onclick=()=>{
  clearInterval(driverTimer);
  $('#driverRequest').classList.add('hidden');
  $('#driverSummary').classList.remove('hidden');
  incomingRide=null;
  toast('Solicitud omitida');
  setTimeout(findWaitingRide,800);
}
$('#acceptBtn').onclick=async()=>{
  if(!(await driverCanOperate(true)))return;
  if(!incomingRide)return toast('La solicitud ya no está disponible');
  clearInterval(driverTimer);
  const ride=incomingRide;
  const {data,error}=await sb.from('rides').update({
    status:'accepted',
    driver_id:deviceId,
    driver_name:user?.name||'Conductor',
    accepted_at:new Date().toISOString()
  }).eq('id',ride.id).eq('status','searching').select().single();
  if(error)return backendError(error,'Otro conductor pudo aceptar este viaje');
  currentRideId=data.id;
  activeRidePrice=Number(data.price||0);
  incomingRide=null;
  driverTripState='to_pickup';
  driverTripStartedAt=null;
  $('#driverRequest').classList.add('hidden');
  $('#driverSummary').classList.add('hidden');
  $('#driverActiveTrip').classList.remove('hidden');
  $('#driverPickupAddress').textContent=data.pickup_address;
  $('#driverDestinationAddress').textContent=data.destination_address;
  setDriverTripState('to_pickup');
  setSheetHeight(sheetLimits().max,true);
  toast('Viaje aceptado. Dirígete al pasajero');
}

function setDriverTripState(state){
  driverTripState=state;
  const arrived=$('#driverArrivedBtn'),start=$('#driverStartTripBtn'),finish=$('#driverFinishTripBtn');
  [arrived,start,finish].forEach(b=>b.classList.add('hidden'));
  ['driverStepPickup','driverStepRide','driverStepFinish'].forEach(id=>$('#'+id).classList.remove('active','done'));
  if(state==='to_pickup'){ $('#driverTripEyebrow').textContent='RECOGIDA';$('#driverTripTitle').textContent='En camino al pasajero';$('#driverTripSubtitle').textContent='Sigue la ruta hasta el punto de recogida.';$('#driverTripBadge').textContent='3 min';$('#driverStepPickup').classList.add('active');arrived.classList.remove('hidden');setNotice('El conductor está en camino al punto de recogida.'); }
  if(state==='arrived'){ $('#driverTripEyebrow').textContent='PASAJERO AVISADO';$('#driverTripTitle').textContent='Llegaste al punto de recogida';$('#driverTripSubtitle').textContent='Espera a que el pasajero suba al vehículo.';$('#driverTripBadge').textContent='Esperando';$('#driverStepPickup').classList.add('active');start.classList.remove('hidden');setNotice('El conductor llegó. El pasajero fue notificado.'); }
  if(state==='in_progress'){ $('#driverTripEyebrow').textContent='VIAJE EN CURSO';$('#driverTripTitle').textContent='Navegando hacia el destino';$('#driverTripSubtitle').textContent='La ruta cambió automáticamente hacia el lugar donde dejarás al pasajero.';$('#driverTripBadge').textContent='8 min';$('#driverStepPickup').classList.add('done');$('#driverStepRide').classList.add('active');finish.classList.remove('hidden');driverTripStartedAt=Date.now();setNotice('Viaje iniciado. Navegación activa hacia el destino.'); }
}
$('#driverArrivedBtn').onclick=async()=>{try{await updateRideStatus('arrived',{arrived_at:new Date().toISOString()});setDriverTripState('arrived');toast('Pasajero avisado: el conductor llegó')}catch(e){}};
$('#driverStartTripBtn').onclick=async()=>{try{await updateRideStatus('in_progress',{started_at:new Date().toISOString()});setDriverTripState('in_progress');toast('Viaje iniciado hacia el destino')}catch(e){}};
$('#driverFinishTripBtn').onclick=async()=>{if(driverTripState!=='in_progress')return toast('Primero debes iniciar el viaje');if(!confirm('¿Llegaron al destino y deseas finalizar el viaje?'))return;try{await updateRideStatus('finished',{finished_at:new Date().toISOString()})}catch(e){return}$('#driverStepPickup').classList.add('done');$('#driverStepRide').classList.add('done');$('#driverStepFinish').classList.add('active');const elapsed=driverTripStartedAt?Math.max(1,Math.round((Date.now()-driverTripStartedAt)/60000)):8;$('#finishDuration').textContent=elapsed+' min';$('#finishDistance').textContent=$('#distance').textContent||'1.4 km';$('#finishPrice').textContent=(activeRidePrice||incomingRide?.price||selected.price)+' CUP';$('#tripFinishedModal').classList.remove('hidden');setNotice('Viaje finalizado correctamente.')};
$('#finishDoneBtn').onclick=()=>{localStorage.removeItem(ARK);incomingRide=null;$('#tripFinishedModal').classList.add('hidden');$('#driverActiveTrip').classList.add('hidden');$('#driverSummary').classList.add('hidden');driverTripState='idle';driverTripStartedAt=null;currentRideId=null;activeRidePrice=0;driverOnline=true;$('#onlineToggle').classList.add('on');$('#onlineText').textContent='Disponible';setDriverPresence(true,currentStart);listenDriverRequests();toast('Viaje terminado. Ya puedes recibir otro');earnings()};
$('#driverCallPassenger').onclick=()=>toast('Llamando al pasajero');
$('#driverTripProblemBtn').onclick=()=>$('#sosModal').classList.remove('hidden');

function startDriverGpsWatch(showToast=true){
  const btn=$('#driverGpsBtn');
  if(gpsWatch!==null)return true;
  if(!navigator.geolocation){if(showToast)toast('GPS no disponible');return false}
  gpsWatch=navigator.geolocation.watchPosition(pos=>{
    btn.dataset.active='1';btn.textContent='GPS activo';btn.style.background='#10a66a';
    currentStart=[pos.coords.latitude,pos.coords.longitude];
    const now=Date.now();if(driverOnline&&now-lastProfileGpsUpdate>5000){lastProfileGpsUpdate=now;setDriverPresence(true,currentStart)}
  },()=>{if(showToast)toast('No se pudo activar el GPS; revisa los permisos')},{enableHighAccuracy:true,maximumAge:3000,timeout:15000});
  return true;
}
$('#driverGpsBtn').onclick=()=>{
  const btn=$('#driverGpsBtn');
  const active=btn.dataset.active==='1'||gpsWatch!==null;
  if(active){
    btn.dataset.active='0';btn.textContent='Activar GPS';btn.style.background='#111';
    if(gpsWatch!==null&&navigator.geolocation)navigator.geolocation.clearWatch(gpsWatch);
    gpsWatch=null;toast('GPS del conductor desactivado');return;
  }
  startDriverGpsWatch(true);
}

const ACTIVE=['searching','accepted','arrived','in_progress'],ARK='rueda_active_ride';let pickedRating=5;
function persist(r){if(r&&ACTIVE.includes(r.status))localStorage.setItem(ARK,JSON.stringify({id:r.id,status:r.status,updated_at:r.updated_at||new Date().toISOString(),snapshot:r}));else localStorage.removeItem(ARK)}
function avatar(el,p,f='👤'){if(el)el.innerHTML=p?`<img src="${p}" alt="Foto">`:f}
async function restore(){if(!user)return;const s=JSON.parse(localStorage.getItem(ARK)||'null');let q=sb.from('rides').select('*');q=s?.id?q.eq('id',s.id):(user.role==='driver'?q.eq('driver_id',deviceId).in('status',ACTIVE):q.eq('passenger_id',deviceId).in('status',ACTIVE));const {data}=await q.order('created_at',{ascending:false}).limit(1),r=data?.[0];if(!r||!ACTIVE.includes(r.status)){localStorage.removeItem(ARK);return}currentRideId=r.id;activeRidePrice=Number(r.price||0);persist(r);if(user.role==='driver'){if(!(await driverCanOperate(false))){localStorage.removeItem(ARK);return}incomingRide=r;driverOnline=true;startDriverGpsWatch(false);startPresenceHeartbeat();setDriverPresence(true,currentStart);$('#onlineToggle').classList.add('on');$('#onlineText').textContent='Disponible';$('#driverSummary').classList.add('hidden');$('#driverActiveTrip').classList.remove('hidden');$('#driverPickupAddress').textContent=r.pickup_address;$('#driverDestinationAddress').textContent=r.destination_address;setDriverTripState(r.status==='accepted'?'to_pickup':r.status)}else{$('#homePanel').classList.add('hidden');$('#tripPanel').classList.remove('hidden');listenPassengerRide(r.id);applyPassengerRide(r)}}
function resetP(rate=false,r=null){stopPassengerChannel();localStorage.removeItem(ARK);currentRideId=null;incomingRide=null;activeRidePrice=0;destinationPoint=null;pendingDestination=null;clearRoute();$('#tripPanel').classList.add('hidden');$('#homePanel').classList.remove('hidden');if(rate&&r&&ratingShownRideId!==String(r.id)){ratingShownRideId=String(r.id);pickedRating=5;ratingSubmitting=false;$('#ratingComment').value='';$('#ratingDriverName').textContent=r.driver_name||'Conductor';avatar($('#ratingDriverAvatar'),r.driver_photo,'🛵');$$('#starPicker button').forEach(b=>b.classList.toggle('on',+b.dataset.star<=5));$('#sendRatingBtn').dataset.id=r.id;$('#sendRatingBtn').disabled=false;$('#ratingModal').classList.remove('hidden')}}
$$('#starPicker button').forEach(b=>b.onclick=()=>{pickedRating=+b.dataset.star;$$('#starPicker button').forEach(x=>x.classList.toggle('on',+x.dataset.star<=pickedRating))});$('#sendRatingBtn').onclick=async()=>{const rideId=$('#sendRatingBtn').dataset.id;if(!rideId||ratingSubmitting)return;ratingSubmitting=true;$('#sendRatingBtn').disabled=true;const {error}=await sb.from('rides').update({rating:pickedRating,rating_comment:$('#ratingComment').value.trim(),rated_at:new Date().toISOString()}).eq('id',rideId);ratingSubmitting=false;$('#sendRatingBtn').disabled=false;if(error)return backendError(error,'No se pudo enviar la calificación');$('#ratingModal').classList.add('hidden');$('#sendRatingBtn').dataset.id='';$('#ratingComment').value='';toast('Gracias por calificar')};$('#skipRatingBtn').onclick=()=>{$('#ratingModal').classList.add('hidden');$('#sendRatingBtn').dataset.id='';$('#ratingComment').value=''};
const ap=applyPassengerRide;applyPassengerRide=function(r){if(!r||r.id!==currentRideId)return;persist(r);ap(r);if(r.driver_photo)avatar($('#passengerDriverAvatar'),r.driver_photo,'🛵');if(r.driver_rating)$('#passengerDriverRating').textContent='⭐ '+Number(r.driver_rating).toFixed(1);if(r.status==='finished')setTimeout(()=>resetP(true,r),600);if(r.status==='canceled')setTimeout(()=>resetP(),250)};
$('#cancelTrip').onclick=async()=>{if(!currentRideId)return resetP();if(!confirm('¿Cancelar este viaje?'))return;const {error}=await sb.from('rides').update({status:'canceled',canceled_at:new Date().toISOString(),canceled_by:'passenger'}).eq('id',currentRideId).in('status',ACTIVE);if(error)return backendError(error,'No se pudo cancelar');resetP();toast('Viaje cancelado')};
const ac=$('#acceptBtn').onclick;$('#acceptBtn').onclick=async function(){await ac.call(this);if(currentRideId){await sb.from('rides').update({driver_photo:user?.photo||null,driver_rating:user?.rating||5,driver_lat:currentStart[0],driver_lng:currentStart[1]}).eq('id',currentRideId);persist({id:currentRideId,status:'accepted'})}};
function applyTheme(c){localStorage.setItem('rueda_theme',c);document.body.classList.toggle('theme-dark',c==='dark'||(c==='auto'&&matchMedia('(prefers-color-scheme:dark)').matches));$$('[data-theme-choice]').forEach(b=>b.classList.toggle('active',b.dataset.themeChoice===c))}$$('[data-theme-choice]').forEach(b=>b.onclick=()=>applyTheme(b.dataset.themeChoice));applyTheme(localStorage.getItem('rueda_theme')||'auto');
async function earnings(){if(user?.role!=='driver')return;$('#driverEarningsPanel').classList.remove('hidden');const {data}=await sb.from('rides').select('price,finished_at').eq('driver_id',deviceId).eq('status','finished');const n=new Date(),d=new Date(n.getFullYear(),n.getMonth(),n.getDate()),w=new Date(d);w.setDate(d.getDate()-((n.getDay()+6)%7));const m=new Date(n.getFullYear(),n.getMonth(),1),sum=x=>(data||[]).filter(r=>new Date(r.finished_at)>=x).reduce((a,r)=>a+Number(r.price||0),0);$('#earnToday').textContent=sum(d)+' CUP';$('#earnWeek').textContent=sum(w)+' CUP';$('#earnMonth').textContent=sum(m)+' CUP'}$('#refreshEarningsBtn').onclick=earnings;
const oa=openApp;openApp=function(){oa();if(user?.role==='driver')earnings();setTimeout(restore,250)};addEventListener('offline',()=>$('#connectionOverlay').classList.remove('hidden'));addEventListener('online',()=>{$('#connectionOverlay').classList.add('hidden');restore()});

window.addEventListener('pagehide',()=>{if(user?.role==='driver'&&driverOnline)setDriverPresence(false,currentStart)});
renderPerKmLabels();updateFare();loadFareSettings();listenFareSettings();openApp();setTimeout(()=>document.getElementById('brandSplash')?.classList.add('hide'),1200);setTimeout(()=>setSheetHeight(sheetLimits().mid,false),80);
// Modo de prueba: no usar el GPS real del teléfono automáticamente.
setTimeout(()=>{
  currentStart=[21.84206,-78.76000];
  gpsReady=true;
  startMarker.setLatLng(currentStart).bindPopup('Ubicación de prueba: Parque José Martí, Ciego de Ávila');
  map.setView(currentStart,16);
},400);
if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js?v=241').then(r=>r.update()).catch(()=>{}))}


window.addEventListener('load', function () {
  window.setTimeout(function () {
    var splash = document.getElementById('brandSplash');
    if (splash) splash.classList.add('hide');
  }, 1100);
});


window.addEventListener('load', function () {
  var possibleIds = [
    'sendCodeBtn','verifyCodeBtn','resendCodeBtn',
    'phoneCodeBtn','emailCodeBtn','continueCodeBtn'
  ];
  possibleIds.forEach(function(id){
    var btn=document.getElementById(id);
    if(!btn) return;
    btn.textContent = id.toLowerCase().includes('verify') ? 'Crear cuenta' : 'Continuar sin código';
    btn.onclick = function(e){
      e.preventDefault();
      var registerBtn=document.getElementById('registerBtn');
      if(registerBtn) registerBtn.click();
    };
  });

  document.querySelectorAll('input').forEach(function(input){
    var name=((input.name||'')+' '+(input.id||'')+' '+(input.placeholder||'')).toLowerCase();
    if(name.includes('code') || name.includes('código') || name.includes('codigo')){
      input.required=false;
      input.style.display='none';
      if(input.parentElement) input.parentElement.style.display='none';
    }
  });
});


window.addEventListener('load', function () {
  window.SOBRE_RUEDAS_DEV = Object.assign({}, window.SOBRE_RUEDAS_DEV || {}, {
    skipDriverApproval: true
  });

  var registerBtn = document.getElementById('registerBtn');
  if (registerBtn) {
    registerBtn.dataset.devDirectDriver = 'true';
  }
});
